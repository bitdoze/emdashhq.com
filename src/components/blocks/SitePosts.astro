---
import { getHubEntries } from "../../lib/hub-content";
import { Icon } from "astro-iconset/components";
import { Image } from "emdash/ui";
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { formatDate } from "../../lib/format";
import SectionHeader from "./SectionHeader.astro";
import SectionLink from "./SectionLink.astro";

type PostsBlock = Extract<PageContentBlock, { _type: "site_posts" }>;
type Props = BlockComponentProps<PostsBlock>;

const { value } = Astro.props;
const { anchor_id, headline, subheadline } = value;

const posts = await getHubEntries(Astro, "posts", value);
---

<section class="section" id={anchor_id || undefined}>
	<div class="container">
		<SectionHeader headline={headline} subheadline={subheadline} meta="Blog" />

		{
			posts.length > 0 ? (
				<ol class="post-index">
					{posts.map((post) => (
						<li class="post-row">
							{post.data.cover?.id && (
								<Image image={post.data.cover} class="post-cover" alt={post.data.cover.alt || ""} />
							)}
							<div class="post-body">
								<div class="badges">
									{post.data.featured && <span class="badge">Featured</span>}
									{post.data.publishedAt && (
										<time class="badge badge-muted" datetime={post.data.publishedAt.toISOString()}>
											{formatDate(post.data.publishedAt)}
										</time>
									)}
								</div>
								<h3 class="post-title">
									<a href={`/blog/${post.id}/`} class="card-link">
										{post.data.title}
									</a>
								</h3>
								{post.data.excerpt && <p class="post-excerpt">{post.data.excerpt}</p>}
							</div>
							<span class="row-source">
								Read
								<Icon name="ph:arrow-right" aria-hidden="true" />
							</span>
						</li>
					))}
				</ol>
			) : (
				<p class="empty-note">No posts published yet.</p>
			)
		}

		<SectionLink label={value.section_cta_label} url={value.section_cta_url} />
	</div>
</section>

<style>
	.post-index {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}

	/* Positioned so the stretched .card-link overlay stays inside its row. */
	.post-row {
		position: relative;
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: var(--spacing-lg);
		align-items: center;
		padding: var(--spacing-lg);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm);
		transition:
			border-color var(--transition-base),
			transform var(--transition-base),
			box-shadow var(--transition-base);
	}

	.post-row:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--color-brand) 45%, var(--color-border));
		box-shadow: var(--shadow-lg);
	}

	.post-cover {
		width: 88px;
		height: 66px;
		object-fit: cover;
		border-radius: var(--radius-sm);
		border: 1px solid var(--color-border);
	}

	.post-body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xs);
	}

	.post-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-lg);
		line-height: 1.3;
		text-wrap: pretty;
	}

	.post-excerpt {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.row-source {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-xs);
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		white-space: nowrap;
	}

	@media (max-width: 640px) {
		.post-row {
			grid-template-columns: 1fr;
		}
		.post-cover {
			width: 100%;
			height: auto;
			aspect-ratio: 16 / 9;
		}
		.row-source {
			display: none;
		}
	}
</style>
