---
/**
 * widget_cards — a grid of linked cards for related tools, further reading
 * or resources. Copy into your site's components and register it for the
 * `widget_cards` block type (see README).
 */
import { sanitizeHref } from "emdash";
import { widgetIcon } from "./icons";

type CardItem = {
	icon?: string | null;
	title: string;
	url: string;
	description?: string | null;
};

type Props = {
	value: {
		title?: string | null;
		items?: CardItem[] | null;
	};
};

const { value } = Astro.props;
const items = (value.items ?? []).filter((item) => item.title && item.url);
---

{
	items.length > 0 && (
		<section class="wgt-cards">
			{value.title && <p class="wgt-cards-title">{value.title}</p>}
			<ul class="wgt-cards-grid">
				{items.map((item) => {
					const icon = widgetIcon(item.icon);
					const external = /^https?:\/\//i.test(sanitizeHref(item.url));
					return (
						<li class="wgt-card">
							{icon && <span class="wgt-card-icon" set:html={icon} />}
							<a
								href={sanitizeHref(item.url)}
								class="wgt-card-link"
								target={external ? "_blank" : undefined}
								rel={external ? "noopener noreferrer" : undefined}
							>
								{item.title}
							</a>
							{item.description && <p class="wgt-card-desc">{item.description}</p>}
						</li>
					);
				})}
			</ul>
		</section>
	)
}

<style>
	.wgt-cards {
		margin-block: var(--spacing-xl, 2rem);
	}

	.wgt-cards-title {
		font-weight: 700;
		font-size: var(--font-size-lg, 1.125rem);
		margin: 0 0 var(--spacing-md, 1rem);
	}

	.wgt-cards-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
		gap: var(--spacing-md, 1rem);
	}

	.wgt-card {
		position: relative;
		padding: var(--spacing-md, 1rem) var(--spacing-lg, 1.5rem);
		border: 1px solid var(--color-border, #e2e0d8);
		border-radius: var(--radius, 10px);
		background: var(--color-surface, #fff);
		transition:
			border-color 140ms ease,
			transform 140ms ease,
			box-shadow 140ms ease;
	}

	.wgt-card:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--color-brand, #4f46e5) 45%, var(--color-border, #e2e0d8));
		box-shadow: var(--shadow-lg, 0 8px 24px rgb(0 0 0 / 0.1));
	}

	.wgt-card-icon {
		display: inline-flex;
		font-size: 1.25rem;
		color: var(--color-brand-strong, #3730a3);
		margin-bottom: var(--spacing-xs, 0.5rem);
	}

	/* Stretched link: the whole card is the click target. */
	.wgt-card-link {
		display: block;
		font-weight: 600;
		color: var(--color-text, inherit);
		text-decoration: none;
	}

	.wgt-card-link::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.wgt-card-desc {
		margin: var(--spacing-xs, 0.5rem) 0 0;
		font-size: var(--font-size-sm, 0.875rem);
		color: var(--color-muted, #555);
		line-height: 1.55;
	}
</style>
