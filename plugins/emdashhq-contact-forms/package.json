{
	"name": "emdashhq-contact-forms",
	"version": "1.2.0",
	"description": "Contact form builder for EmDash CMS: forms as page blocks, submissions stored in the database, delivery through the site's active email provider.",
	"type": "module",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs",
		"./site/*": "./site/*"
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc",
		"site",
		"docs",
		"images",
		"README.md"
	],
	"keywords": [
		"emdash",
		"emdash-plugin",
		"contact-form",
		"forms"
	],
	"license": "MIT",
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"bundle": "emdash-plugin bundle",
		"login": "emdash-plugin login",
		"publish": "emdash-plugin publish",
		"test": "emdash-plugin validate && vitest run && vitest run --config vitest.browser.config.ts"
	},
	"peerDependencies": {
		"emdash": ">=1.2.0"
	},
	"devDependencies": {
		"@emdash-cms/blocks": "*",
		"@emdash-cms/plugin-cli": "0.13.2",
		"@emdash-cms/plugin-test": "^0.2.8",
		"emdash": "^1.2.0",
		"happy-dom": "^20.14.6",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0",
		"zod": "^4.6.5"
	}
}
