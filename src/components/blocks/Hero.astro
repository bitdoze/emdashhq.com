---
import { getMenuWithCacheHint } from "emdash";
import { Image, type BlockComponentProps } from "emdash/ui";
import { Icon } from "astro-iconset/components";
import type { PageContentBlock } from "../../../emdash-env";
import { optionalLink, isCurrentPath } from "../../lib/links";
import { iconFor } from "../../lib/icons";
import NewTab from "../NewTab.astro";

type HeroBlock = Extract<PageContentBlock, { _type: "marketing_hero" }>;
type Props = BlockComponentProps<HeroBlock>;

const { value } = Astro.props;
const { anchor_id, eyebrow, headline, subheadline, image, centered } = value;
const specs = value.specs ?? [];

const primaryCta = optionalLink(value.primary_cta_label, value.primary_cta_url);
const secondaryCta = optionalLink(value.secondary_cta_label, value.secondary_cta_url);

const revision = new Date().getFullYear();
const figLabel = image?.alt ? image.alt : "Reference";

/*
 * The hero is an issue in the series, so its number matches the nav
 * index: pages in the primary menu are No. 01..NN; a page outside the
 * menu (the home cover) is the series itself.
 */
const menuResult = await getMenuWithCacheHint("primary");
if (Astro.cache?.enabled) Astro.cache.set(menuResult.cacheHint);
const menuIndex = (menuResult.data?.items ?? []).findIndex((item) => isCurrentPath(item.url, Astro.url));
const issueToken = menuIndex >= 0 ? `No. ${String(menuIndex + 1).padStart(2, "0")}` : `Vol. ${revision}`;

/*
 * Every issue carries the same architecture colophon figure, numbered to
 * its issue, with the terminal card showing the command that issue is
 * about. The home cover is Fig. 00 and keeps the deploy claim.
 */
const FIGURES = [
	{ cmd: "emdash seed", out: "Seed applied" }, // 01 Tutorials
	{ cmd: "astro dev --host", out: "Ready on :4321" }, // 02 Videos
	{ cmd: "astro check", out: "0 errors" }, // 03 Themes
	{ cmd: "emdash migrate --check", out: "Migrations current" }, // 04 Plugins
	{ cmd: "wrangler deploy", out: "Deployed!" }, // 05 Services
	{ cmd: "POST /submit", out: "303 · sent" }, // 06 Contact
];
const issueFig = menuIndex >= 0 ? (FIGURES[menuIndex] ?? FIGURES[0]) : { cmd: "wrangler deploy", out: "Deployed!" };
const figNum = menuIndex >= 0 ? String(menuIndex + 1).padStart(2, "0") : "00";

/*
 * The covers put the pink marker on the headline's last phrase.
 * Authors can pin it with *asterisks*; without a marker the text after
 * the final comma is highlighted, or the last three words when the
 * headline runs long.
 */
const headlineParts = (() => {
	const h = headline ?? "";
	const star = h.match(/^(.*?)\*([^*]+)\*(.*)$/s);
	if (star) return { lead: star[1].trim(), mark: star[2].trim(), tail: star[3].trim() };
	const i = h.lastIndexOf(",");
	const tail = i > 0 ? h.slice(i + 1).trim() : "";
	if (tail && tail.length <= 28) return { lead: h.slice(0, i + 1).trim(), mark: tail, tail: "" };
	const words = h.split(/\s+/);
	if (words.length >= 7) return { lead: words.slice(0, -3).join(" "), mark: words.slice(-3).join(" "), tail: "" };
	return { lead: h, mark: "", tail: "" };
})();
---

<section
	id={anchor_id || undefined}
	class:list={["hero-wrap", { "hero-centered": centered, "hero-with-image": !!image, "hero-cover": Astro.url.pathname === "/" }]}
>
	<div class="hero-glow-primary" aria-hidden="true"></div>
	<div class="hero-glow-secondary" aria-hidden="true"></div>
	<div class="hero">
		<div class="hero-content">
			<p class="hero-eyebrow">
				<span class="eyebrow-dot" aria-hidden="true"></span>
				<span class="eyebrow-text">{eyebrow || "EmDash CMS Hub"}</span>
				<span class="eyebrow-divider" aria-hidden="true">·</span>
				<span class="eyebrow-meta">{issueToken}</span>
			</p>
			<h1 class="hero-headline">
				{headlineParts.lead}
				{headlineParts.mark && <> <span class="hl">{headlineParts.mark}</span></>}
				{headlineParts.tail && <> {headlineParts.tail}</>}
			</h1>
			{subheadline && <p class="hero-subheadline">{subheadline}</p>}
			{(primaryCta || secondaryCta) && (
				<div class="hero-actions">
					{primaryCta && (
						<a href={primaryCta.href} target={primaryCta.target} rel={primaryCta.rel} class="btn btn-primary btn-lg hero-cta-primary">
							<span>{primaryCta.label}</span>
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="hero-cta-arrow"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
							{primaryCta.target === "_blank" && <NewTab />}
						</a>
					)}
					{secondaryCta && (
						<a href={secondaryCta.href} target={secondaryCta.target} rel={secondaryCta.rel} class="btn btn-secondary btn-lg">
							{secondaryCta.label}
							{secondaryCta.target === "_blank" && <NewTab />}
						</a>
					)}
				</div>
			)}
			{specs.length > 0 && (
				<div class="hero-specs" aria-label="Architecture highlights">
					{specs.map((spec) => (
						<div class="spec-item">
							<Icon name={iconFor(spec.icon)} width={13} height={13} aria-hidden="true" />
							<span>{spec.label}</span>
						</div>
					))}
				</div>
			)}
			{
				(image || centered) && (
					<figure class="hero-schematic" aria-label="How EmDash is wired: reader, browser, Worker, database, media, admin">
						<svg viewBox="0 0 560 72" fill="none" role="img">
							<title>System diagram</title>
							<desc>A reader's browser talks to an Astro Worker, which reads from the D1 database and R2 media store; the admin console writes to both.</desc>
							<g class="schematic">
								<line class="ink stroke-draw" style="--d: 0ms" x1="52" y1="36" x2="128" y2="36" />
								<line class="ink stroke-draw" style="--d: 160ms" x1="224" y1="36" x2="296" y2="36" />
								<line class="ink stroke-draw" style="--d: 320ms" x1="392" y1="36" x2="424" y2="20" />
								<line class="ink stroke-draw" style="--d: 320ms" x1="392" y1="36" x2="424" y2="52" />
								<rect class="ink stroke-draw fill" style="--d: 80ms" x="8" y="22" width="44" height="28" rx="4" />
								<rect class="ink stroke-draw fill" style="--d: 240ms" x="128" y="22" width="96" height="28" rx="4" />
								<rect class="ink stroke-draw fill" style="--d: 400ms" x="296" y="22" width="96" height="28" rx="4" />
								<rect class="ink stroke-draw fill" style="--d: 560ms" x="424" y="8" width="128" height="24" rx="4" />
								<rect class="ink stroke-draw fill" style="--d: 560ms" x="424" y="42" width="128" height="24" rx="4" />
								<text class="label" style="--d: 700ms" x="30" y="40" text-anchor="middle">YOU</text>
								<text class="label" style="--d: 780ms" x="176" y="40" text-anchor="middle">BROWSER</text>
								<text class="label" style="--d: 860ms" x="344" y="40" text-anchor="middle">WORKER</text>
								<text class="label" style="--d: 960ms" x="488" y="24" text-anchor="middle">D1 · R2</text>
								<text class="label" style="--d: 1040ms" x="488" y="58" text-anchor="middle">ADMIN</text>
							</g>
						</svg>
						<figcaption class="hero-fig">Fig. {figNum}: how the pieces connect</figcaption>
					</figure>
				)
			}
		</div>
		{
			image ? (
				<figure class="hero-image">
					<Image image={image} class="hero-image-media" priority />
					<figcaption class="hero-fig">Fig. 01: {figLabel}</figcaption>
				</figure>
			) : !centered && (
				<figure class="hero-panel" aria-label="How EmDash is wired, from a visitor's request down to a successful wrangler deploy">
					<span class="hero-tape" aria-hidden="true"></span>
					<div class="hero-stamp" aria-hidden="true">
						<span>Edge</span>
						<span>SSR</span>
					</div>
					<div class="panel-header">
						<div class="panel-dots" aria-hidden="true">
							<span class="p-dot p-red"></span>
							<span class="p-dot p-yellow"></span>
							<span class="p-dot p-green"></span>
						</div>
						<span class="panel-mark"><img src="/brand/emdash-dark-text.svg" alt="EmDash" class="panel-logo panel-logo--dark" width="40" height="10" /><img src="/brand/emdash-light-text.svg" alt="" aria-hidden="true" class="panel-logo panel-logo--light" width="40" height="10" /></span>
						<span class="panel-title">emdash-architecture.svg</span>
						<span class="panel-spacer" aria-hidden="true"></span>
					</div>
					<div class="panel-svg-wrap">
						<svg viewBox="0 0 560 340" fill="none" role="img">
							<title>System diagram</title>
							<desc>A visitor's browser requests a page; the Astro Worker server-renders it and reads content from the D1 database and media from R2; the EmDash admin console writes to both.</desc>
							<g class="schematic">
								<!-- flow: visitor -> browser -> worker -->
								<rect class="ink stroke-draw fill" style="--d: 0ms" x="12" y="150" width="96" height="44" rx="6" />
								<text class="label" style="--d: 500ms" x="60" y="176" text-anchor="middle">VISITOR</text>
								<line class="ink stroke-draw" style="--d: 160ms" x1="108" y1="172" x2="146" y2="172" />
								<path class="ink head" style="--d: 400ms" d="M140 167 L148 172 L140 177" />
								<rect class="ink stroke-draw fill" style="--d: 240ms" x="150" y="150" width="110" height="44" rx="6" />
								<text class="label" style="--d: 620ms" x="205" y="176" text-anchor="middle">BROWSER</text>
								<line class="ink stroke-draw" style="--d: 380ms" x1="260" y1="172" x2="298" y2="172" />
								<path class="ink head" style="--d: 620ms" d="M292 167 L300 172 L292 177" />
								<rect class="ink strong stroke-draw fill" style="--d: 460ms" x="302" y="150" width="110" height="44" rx="6" />
								<circle class="status-indicator status-green" cx="398" cy="162" r="3" />
								<text class="label" style="--d: 840ms" x="357" y="170" text-anchor="middle">WORKER</text>
								<text class="sublabel" style="--d: 900ms" x="357" y="185" text-anchor="middle">ASTRO · SSR</text>
								<!-- spine feeds the storage and admin nodes -->
								<line class="ink stroke-draw" style="--d: 600ms" x1="412" y1="172" x2="426" y2="172" />
								<line class="ink stroke-draw" style="--d: 700ms" x1="426" y1="60" x2="426" y2="282" />
								<line class="ink stroke-draw" style="--d: 760ms" x1="426" y1="60" x2="444" y2="60" />
								<path class="ink head" style="--d: 900ms" d="M438 55 L446 60 L438 65" />
								<line class="ink stroke-draw" style="--d: 800ms" x1="426" y1="172" x2="444" y2="172" />
								<path class="ink head" style="--d: 940ms" d="M438 167 L446 172 L438 177" />
								<line class="ink stroke-draw" style="--d: 840ms" x1="426" y1="282" x2="444" y2="282" />
								<path class="ink head" style="--d: 980ms" d="M438 277 L446 282 L438 287" />
								<rect class="ink stroke-draw fill" style="--d: 860ms" x="448" y="40" width="100" height="40" rx="6" />
								<circle class="status-indicator status-amber" cx="534" cy="50" r="3" />
								<text class="label" style="--d: 1060ms" x="498" y="58" text-anchor="middle">D1</text>
								<text class="sublabel" style="--d: 1100ms" x="498" y="72" text-anchor="middle">CONTENT</text>
								<rect class="ink stroke-draw fill" style="--d: 900ms" x="448" y="152" width="100" height="40" rx="6" />
								<text class="label" style="--d: 1120ms" x="498" y="170" text-anchor="middle">R2</text>
								<text class="sublabel" style="--d: 1160ms" x="498" y="184" text-anchor="middle">MEDIA</text>
								<rect class="ink stroke-draw fill" style="--d: 940ms" x="448" y="262" width="100" height="40" rx="6" />
								<text class="label" style="--d: 1200ms" x="498" y="280" text-anchor="middle">ADMIN</text>
								<text class="sublabel" style="--d: 1240ms" x="498" y="294" text-anchor="middle">WRITES</text>
								<!-- dimension annotation, drafting style -->
								<line class="dim stroke-draw" style="--d: 1000ms" x1="150" y1="240" x2="412" y2="240" />
								<line class="dim stroke-draw" style="--d: 1060ms" x1="150" y1="232" x2="150" y2="248" />
								<line class="dim stroke-draw" style="--d: 1060ms" x1="412" y1="232" x2="412" y2="248" />
								<text class="dimlabel" style="--d: 1300ms" x="281" y="230" text-anchor="middle">REQUEST / RESPONSE</text>
							</g>
						</svg>
					</div>
					<div class="panel-footer">
						<span class="panel-caption">Fig. {figNum}: CMS architecture</span>
						<span class="panel-latency">Content served from the edge</span>
					</div>
					<div class="hero-terminal" aria-hidden="true">
						<span class="term-line"><span class="term-prompt">$</span> {issueFig.cmd}</span>
						<span class="term-ok">
							<Icon name="ph:check-circle" aria-hidden="true" />
							{issueFig.out}
						</span>
					</div>
				</figure>
			)
		}
	</div>
</section>

<style>
	.hero-wrap {
		position: relative;
		overflow: clip;
		border-bottom: var(--line-hair) solid var(--color-border);
	}

	.hero-glow-primary {
		position: absolute;
		top: 4%;
		right: 2%;
		width: 560px;
		height: 440px;
		border-radius: 50%;
		background: radial-gradient(
			circle,
			color-mix(in srgb, var(--color-accent) 20%, transparent) 0%,
			color-mix(in srgb, var(--color-warm) 9%, transparent) 45%,
			transparent 72%
		);
		filter: blur(72px);
		pointer-events: none;
		z-index: 0;
	}

	.hero-glow-secondary {
		position: absolute;
		top: 42%;
		left: 4%;
		width: 380px;
		height: 300px;
		border-radius: 50%;
		background: radial-gradient(
			circle,
			color-mix(in srgb, var(--color-warm) 11%, transparent) 0%,
			transparent 65%
		);
		filter: blur(56px);
		pointer-events: none;
		z-index: 0;
	}

	.hero {
		position: relative;
		z-index: 1;
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: clamp(3.5rem, 7vw, 6rem) var(--spacing-lg) clamp(3rem, 6vw, 5rem);
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: var(--spacing-3xl);
		align-items: center;
	}

	.hero-centered {
		text-align: center;
	}

	.hero-centered .hero {
		grid-template-columns: 1fr;
		max-width: var(--max-width);
		padding-top: var(--spacing-4xl);
		padding-bottom: var(--spacing-xl);
	}

	.hero-centered .hero-content {
		max-width: 100%;
		align-items: center;
	}

	.hero-centered .hero-actions,
	.hero-centered .hero-eyebrow,
	.hero-centered .hero-specs {
		justify-content: center;
	}

	.hero-centered .hero-subheadline {
		margin-inline: auto;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-lg);
		max-width: 640px;
		/* Keep the heading and navigation actions visible immediately. */
	}

	/* Eyebrow: the covers' letterspaced series line. */
	.hero-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin: 0;
	}

	.eyebrow-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-accent);
	}

	.eyebrow-text {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--color-text);
	}

	.eyebrow-divider {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	/* Keep the run together so "VOL. 2026" never splits across lines. */
	.eyebrow-meta {
		white-space: nowrap;
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 500;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.hero-headline {
		font-family: var(--font-heading);
		font-size: clamp(1.9rem, 3.4vw, 2.75rem);
		font-weight: var(--font-weight-display);
		line-height: 1.1;
		letter-spacing: var(--tracking-snug);
		text-transform: uppercase;
		color: var(--color-text);
		text-wrap: balance;
	}

	.hero-headline .hl {
		font-style: italic;
		letter-spacing: 0;
	}

	.hero-subheadline {
		max-width: 52ch;
		font-size: var(--font-size-lg);
		line-height: var(--leading-normal);
		color: var(--color-muted);
		text-wrap: pretty;
	}

	.hero-actions {
		display: flex;
		gap: var(--spacing-md);
		flex-wrap: wrap;
		align-items: center;
	}

	.hero-cta-primary {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.hero-cta-arrow {
		transition: transform var(--transition-base);
	}

	.hero-cta-primary:hover .hero-cta-arrow {
		transform: translateX(4px);
	}

	/* Specs: the covers' outline chips. */
	.hero-specs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
	}

	.spec-item {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 0.3rem 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--color-text);
		background: var(--color-surface);
		border: 1px solid color-mix(in srgb, var(--color-text) 55%, var(--color-border));
		border-radius: var(--radius-full);
		box-shadow: var(--shadow-sm);
	}

	.spec-item svg {
		color: var(--color-accent);
	}

	/* Reference plate: a real screenshot framed as a paper figure. */
	.hero-image {
		position: relative;
		margin: 0;
		padding: var(--spacing-sm);
		background: var(--color-surface);
		border: var(--line-hair) solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-xl);
		transform: rotate(1.2deg);
		/* Visible on the first paint. */
	}

	.hero-image :global(.hero-image-media) {
		width: 100%;
		height: auto;
		border-radius: calc(var(--radius-lg) - 6px);
		border: 1px solid var(--color-border);
	}

	/* The schematic panel: a printed figure card on the desk, a touch
	   crooked, taped down, stamped, with the deploy card on top. */
	.hero-panel {
		position: relative;
		margin: 0;
		padding: var(--spacing-lg);
		padding-bottom: calc(var(--spacing-lg) + 44px);
		border: var(--line-hair) solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		box-shadow: var(--shadow-xl);
		transform: rotate(1.4deg);
		/* Visible on the first paint. */
	}

	/* Washi tape holding the card down. */
	.hero-tape {
		position: absolute;
		top: -13px;
		left: 34px;
		width: 92px;
		height: 26px;
		background: color-mix(in srgb, var(--color-accent) 30%, transparent);
		border-left: 1px dashed color-mix(in srgb, var(--color-accent) 60%, transparent);
		border-right: 1px dashed color-mix(in srgb, var(--color-accent) 60%, transparent);
		transform: rotate(-4deg);
		border-radius: 2px;
		pointer-events: none;
		z-index: 2;
	}

	/* The postal stamp on the card's corner. */
	.hero-stamp {
		position: absolute;
		top: -22px;
		right: -14px;
		width: 74px;
		height: 74px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1px;
		font-family: var(--font-mono);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		line-height: 1.25;
		color: var(--color-accent-text);
		background: var(--color-surface);
		border: 2px solid var(--color-accent);
		border-radius: 50%;
		box-shadow: 0 0 0 3px var(--color-surface), 0 0 0 4px color-mix(in srgb, var(--color-accent) 55%, transparent), var(--shadow);
		transform: rotate(12deg);
		pointer-events: none;
		z-index: 2;
	}

	/* The little deploy card overlapping the figure's foot. */
	.hero-terminal {
		position: absolute;
		left: var(--spacing-lg);
		right: var(--spacing-lg);
		bottom: -26px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-md);
		padding: 0.7rem 1rem;
		background: var(--color-plate);
		border: 1px solid var(--color-plate-border);
		border-radius: var(--radius);
		box-shadow: var(--shadow-lg);
		transform: rotate(-1.8deg);
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		color: var(--color-plate-ink);
		z-index: 2;
	}

	.term-line {
		font-weight: 500;
		letter-spacing: 0.04em;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.term-prompt {
		color: var(--color-accent-soft);
		font-weight: 700;
	}

	.term-ok {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-weight: 600;
		letter-spacing: 0.06em;
		color: var(--color-plate-ok);
		white-space: nowrap;
	}

	.term-ok :global(svg) {
		font-size: 1rem;
	}

	/* Console / Window chrome for panel */
	.panel-header {
