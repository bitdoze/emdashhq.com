---
import { getHubEntries } from "../../lib/hub-content";
import { Icon } from "astro-iconset/components";
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { formatDate, labelize, lines } from "../../lib/format";
import { linkAttrs } from "../../lib/links";
import FilterBar from "./FilterBar.astro";
import NewTab from "../NewTab.astro";
import SectionHeader from "./SectionHeader.astro";
import SectionLink from "./SectionLink.astro";

type ResourcesBlock = Extract<PageContentBlock, { _type: "site_resources" }>;
type Props = BlockComponentProps<ResourcesBlock>;

const { value } = Astro.props;
const { anchor_id, headline, subheadline, show_filters } = value;

const resources = await getHubEntries(Astro, "resources", value);

const priceOptions = [...new Set(resources.map((entry) => entry.data.price_type))].map((type) => ({
	value: type,
	label: labelize(type),
}));

const KIND_ICON = { plugin: "ph:plug", theme: "ph:palette" } as const;
---

<section class="section" id={anchor_id || undefined}>
	<div class="container" data-filter-root>
		<SectionHeader headline={headline} subheadline={subheadline} meta="Catalog" />
		{show_filters && <FilterBar options={priceOptions} label="Filter by price" />}

		{
			resources.length > 0 ? (
				<div class="res-ledger">
					{resources.map((entry) => {
						const link = linkAttrs(entry.data.url);
						const demo = entry.data.demo_url ? linkAttrs(entry.data.demo_url) : undefined;
						const isPaid = entry.data.price_type === "paid";
						const updated = formatDate(entry.data.updated);
						const kindIcon = KIND_ICON[entry.data.kind as keyof typeof KIND_ICON] ?? "ph:sparkle";
						const changes = lines(entry.data.changelog);
						return (
							<article class="res-row" data-filter-item data-filter-value={entry.data.price_type}>
								<a href={link.href} target={link.target} rel={link.rel} class="res-thumb" tabindex="-1" aria-hidden="true">
									{entry.data.image ? (
										<Image image={entry.data.image} class="res-shot" />
									) : (
										<span class="res-plate">
											<Icon name={kindIcon} width={26} height={26} aria-hidden="true" />
										</span>
									)}
								</a>
								<div class="res-main">
									<div class="badges">
										<span class="badge badge-muted">{labelize(entry.data.kind)}</span>
										<span class:list={["badge", isPaid ? "badge-paid" : "badge-free"]}>
											{isPaid && entry.data.price ? `Paid, ${entry.data.price}` : labelize(entry.data.price_type)}
										</span>
									</div>
									<h3 class="res-title">
										<a href={link.href} target={link.target} rel={link.rel} class="card-link">
											{entry.data.title}
										</a>
									</h3>
									{entry.data.summary && <p class="res-summary">{entry.data.summary}</p>}
									{changes.length > 0 && (
										<details class="res-changes">
											<summary>What changed</summary>
											<ul class="res-changes-list">
												{changes.map((line) => (
													<li>{line}</li>
												))}
											</ul>
										</details>
									)}
								</div>
								<div class="res-rail">
									{entry.data.latest_version && <span class="res-version">v{entry.data.latest_version.replace(/^v/, "")}</span>}
									<span class="res-specs">
										{[entry.data.license, entry.data.publisher, updated && `Upd. ${updated}`].filter(Boolean).join(" · ")}
									</span>
									{entry.data.package && <code class="res-package">{entry.data.package}</code>}
									<div class="res-actions">
										<span class="btn btn-primary res-cta">
											{entry.data.cta_label || "View"}
											<Icon name="ph:arrow-right" width={13} height={13} aria-hidden="true" />
										</span>
										{demo && (
											<a href={demo.href} target={demo.target} rel={demo.rel} class="res-demo">
												Demo
												{demo.target === "_blank" && <NewTab />}
											</a>
										)}
									</div>
								</div>
							</article>
						);
					})}
				</div>
			) : (
				<p class="empty-note">Nothing listed here yet.</p>
			)
		}

		{
			/* A lone row or two on the shelf reads as broken;
			   say it's the whole shelf instead. */
			resources.length > 0 && resources.length <= 2 && (
				<p class="empty-note">That's the whole shelf for now. New themes and plugins land here as they ship.</p>
			)
		}

		<SectionLink label={value.section_cta_label} url={value.section_cta_url} />
	</div>
</section>

<style>
	/* The catalog reads as a ledger: hairline-ruled rows with a thumbnail,
	   the story in the middle, and a mono spec rail on the right — a different
	   silhouette from the card grids used by tutorials and posts. */
	.res-ledger {
		border-top: var(--line-ink) solid var(--color-border);
	}

	.res-row {
		position: relative;
		display: grid;
		grid-template-columns: 168px minmax(0, 1fr) 200px;
		gap: var(--spacing-xl);
		align-items: center;
		padding: var(--spacing-lg) var(--spacing-sm);
		border-bottom: var(--line-hair) solid var(--color-border);
		transition: background var(--transition-fast);
	}

	.res-row:hover {
		background: color-mix(in srgb, var(--color-brand) 4%, transparent);
	}

	.res-thumb {
		display: block;
		position: relative;
		z-index: 1;
		border-radius: var(--radius);
		overflow: hidden;
		border: var(--line-hair) solid var(--color-border);
		background: var(--color-surface);
		aspect-ratio: 4 / 3;
		box-shadow: var(--shadow-sm);
	}

	.res-thumb :global(.res-shot) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.4s cubic-bezier(0.2, 0, 0.2, 1);
	}

	.res-row:hover .res-thumb :global(.res-shot) {
		transform: scale(1.05);
	}

	.res-plate {
		display: flex;
		width: 100%;
		height: 100%;
		align-items: center;
		justify-content: center;
		color: var(--color-accent-text);
		background:
			radial-gradient(circle at 30% 25%, color-mix(in srgb, var(--color-accent) 14%, transparent), transparent 60%),
			var(--color-surface);
	}

	.res-main {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
	}

	.res-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		line-height: 1.25;
		text-wrap: pretty;
	}

	.res-title .card-link {
		color: inherit;
		text-decoration: none;
	}

	.res-title .card-link::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	.res-summary {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.res-changes {
		position: relative;
		z-index: 1;
	}

	.res-changes summary {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent-text);
		cursor: pointer;
	}

	.res-changes-list {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		margin-top: var(--spacing-sm);
		padding-left: 1rem;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.res-changes-list li::marker {
		color: var(--color-accent-text);
	}

	/* The right rail is a spec sheet: version in ink, the rest in mono. */
	.res-rail {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: var(--spacing-xs);
		text-align: right;
	}

	.res-version {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-display);
		color: var(--color-brand-strong);
		line-height: 1.1;
	}

	.res-specs {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		line-height: 1.6;
		color: var(--color-muted);
	}

	.res-package {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		color: var(--color-accent-text);
		background: color-mix(in srgb, var(--color-accent) 10%, transparent);
		border-radius: var(--radius-sm);
		padding: 0.15em 0.5em;
		max-width: 100%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.res-actions {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		margin-top: var(--spacing-sm);
	}

	.res-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		font-size: var(--font-size-xs);
		padding: var(--spacing-sm) var(--spacing-md);
		white-space: nowrap;
		pointer-events: none;
	}

	.res-demo {
		position: relative;
		z-index: 1;
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-brand-strong);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--color-accent) 60%, transparent);
		text-underline-offset: 3px;
	}

	.res-demo:hover {
		text-decoration-color: var(--color-accent);
	}

	@media (max-width: 900px) {
		.res-row {
			grid-template-columns: 120px minmax(0, 1fr);
		}

		.res-rail {
			grid-column: 1 / -1;
			flex-direction: row;
			flex-wrap: wrap;
			align-items: center;
			justify-content: flex-start;
			text-align: left;
			gap: var(--spacing-sm) var(--spacing-md);
			border-top: var(--line-hair) solid var(--color-border);
			padding-top: var(--spacing-md);
		}

		.res-actions {
			margin-top: 0;
			margin-left: auto;
		}
	}

	@media (max-width: 540px) {
		.res-row {
			grid-template-columns: minmax(0, 1fr);
			padding: var(--spacing-lg) 0;
		}

		.res-thumb {
			aspect-ratio: 16 / 9;
		}
	}
</style>
