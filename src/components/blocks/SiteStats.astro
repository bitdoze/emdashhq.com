---
import { env } from "cloudflare:workers";
import { getSiteStats } from "../../lib/site-stats";
import NewTab from "../NewTab.astro";

/* Where each counter points — all sources are external. */
const STAT_LINKS: Record<string, string> = {
	npm_downloads: "https://www.npmjs.com/package/emdash",
	plugins: "https://plugins.emdashcms.com/",
	sites: "https://trends.builtwith.com/cms/EmDash-CMS",
};

const db = (env as Env).DB;
const cfContext = (Astro.locals as { cfContext?: { waitUntil(p: Promise<unknown>): void } }).cfContext;

let stats: Awaited<ReturnType<typeof getSiteStats>> = [];
try {
	if (db) {
		stats = await getSiteStats(db, (job) => cfContext?.waitUntil(job));
	}
} catch {
	stats = []; // table unavailable — leave the strip out rather than break the page
}
const visible = stats.filter((s) => s.value > 0);
---

{
	visible.length > 0 && (
		<section class="section stats-section" aria-labelledby="stats-title">
			<div class="container">
				<header class="section-header stats-header">
					<p class="section-meta" id="stats-title">
						By the numbers
					</p>
				</header>
				<dl class="stats-row">
					{visible.map((s) => {
						const url = STAT_LINKS[s.key];
						const external = url ? /^https?:/i.test(url) : false;
						return (
							<div class="stat-cell">
								<dt class="stat-label">{s.label}</dt>
								<dd class="stat-value">
									{url ? (
										<a
											class="stat-link"
											href={url}
											{...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
											aria-label={`${s.value.toLocaleString("en-US")}${s.suffix} ${s.label}`}
										>
											{external && <NewTab />}
										</a>
									) : null}
									{s.value.toLocaleString("en-US")}
									{s.suffix}
									{external && <span class="stat-ext" aria-hidden="true"> ↗</span>}
								</dd>
								{s.weekDelta !== null && (
									<dd class={`stat-delta${s.weekDelta < 0 ? " stat-delta-down" : ""}`}>
										{s.weekDelta > 0 ? "+" : ""}
										{s.weekDelta.toLocaleString("en-US")} this week
									</dd>
								)}
							</div>
						);
					})}
				</dl>
				<p class="stats-note">
					Installs are npmjs.org downloads for the last 30 days; plugins counts the official
					registry; sites tracks BuiltWith Trends. Refreshed once a day.
				</p>
			</div>
		</section>
	)
}

<style>
	.stats-section {
		padding-top: var(--spacing-3xl);
	}

	.stats-header {
		margin-bottom: var(--spacing-lg);
	}

	/* Ledger strip: hairline rules, serif figures, mono captions. */
	.stats-row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		border-top: var(--line-ink) solid var(--color-text);
		border-bottom: 1px solid var(--color-border);
		margin: 0;
	}

	.stat-cell {
		position: relative;
		display: flex;
		flex-direction: column-reverse;
		gap: var(--spacing-xs);
		padding: var(--spacing-lg) var(--spacing-lg) var(--spacing-lg) 0;
		margin-right: var(--spacing-lg);
	}

	/* Stretched overlay so the whole cell is the link. */
	.stat-link::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	.stat-link:focus-visible::after {
		outline: 2px solid var(--color-brand);
		outline-offset: 4px;
	}

	.stat-ext {
		font-family: var(--font-mono);
		font-size: 0.55em;
		color: var(--color-accent-text);
		vertical-align: super;
		letter-spacing: 0;
	}

	.stat-cell:hover .stat-value {
		color: var(--color-brand-strong);
	}

	.stat-cell + .stat-cell {
		border-left: 1px solid var(--color-border);
		padding-left: var(--spacing-lg);
	}

	.stat-value {
		font-family: var(--font-heading);
		font-size: clamp(1.9rem, 3.2vw, 2.6rem);
		font-weight: var(--font-weight-display);
		line-height: 1;
		letter-spacing: -0.02em;
		color: var(--color-text);
		margin: 0;
		font-variant-numeric: lining-nums tabular-nums;
	}

	.stat-label {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-accent-text);
		margin: 0;
	}

	.stat-delta {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		letter-spacing: 0.05em;
		color: var(--color-success);
		margin: var(--spacing-xs) 0 0;
	}

	.stat-delta-down {
		color: var(--color-muted);
	}

	.stats-note {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		margin-top: var(--spacing-sm);
	}

	@media (max-width: 700px) {
		/* Ledger rows: label left, figure right, delta beneath the figure. */
		.stats-row {
			grid-template-columns: 1fr;
		}
		.stat-cell {
			flex-direction: row;
			flex-wrap: wrap;
			align-items: baseline;
			justify-content: space-between;
			column-gap: var(--spacing-md);
			padding: var(--spacing-md) 0;
			margin-right: 0;
		}
		.stat-cell + .stat-cell {
			border-left: 0;
			border-top: 1px solid var(--color-border);
			padding-left: 0;
		}
		.stat-value {
			font-size: 1.9rem;
			text-align: right;
		}
		.stat-label {
			flex: 1;
			min-width: 55%;
		}
		.stat-delta {
			flex-basis: 100%;
			margin-top: 0;
			text-align: right;
		}
	}
</style>
