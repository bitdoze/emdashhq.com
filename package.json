{
  "name": "emdashhq",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "EmDash HQ",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && npm run migrate:check && wrangler deploy && npm run cache:warm",
    "migrate:check": "emdash migrate --check --wrangler-config wrangler.jsonc",
    "cache:warm": "node scripts/warm-cache.mjs",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/react": "^6.0.5",
    "@emdash-cms/cloudflare": "^1.1.0",
    "@emdashhq/plugin-site-scripts": "file:plugins/site-scripts",
    "emdashhq-contact-forms": "file:plugins/emdashhq-contact-forms",
    "@iconify-json/ph": "^1.2.2",
    "astro": "^7.3.2",
    "astro-iconset": "^0.0.4",
    "emdash": "^1.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260820.1",
    "wrangler": "^4.125.0"
  }
}
