---
/**
 * widget_notice — colored callout (info, success, warning, danger) with a
 * rich-text body. Copy into your site's components and register it for the
 * `widget_notice` block type (see README).
 */
import { PortableText } from "emdash/ui";

type Props = {
	value: {
		kind?: "info" | "success" | "warning" | "danger" | null;
		title?: string | null;
		body: unknown[];
	};
};

const { value } = Astro.props;
const kind = value.kind ?? "info";

const icons: Record<string, string> = {
	info: '<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>',
	success:
		'<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>',
	warning:
		'<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>',
	danger:
		'<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 8.586 8.707 7.293l-1.293-1.293a1 1 0 00-1.414-1.414L10 8.586l1.293 1.293a1 1 0 001.414-1.414L10 8.586l-1.293-1.293a1 1 0 00-1.414-1.414L10 8.586l1.293 1.293z" clip-rule="evenodd"/></svg>',
};
---

<aside class={`wgt-notice wgt-notice-${kind}`} role={kind === "danger" || kind === "warning" ? "alert" : "note"}>
	<span class="wgt-notice-icon" set:html={icons[kind]} />
	<div class="wgt-notice-body">
		{value.title && <p class="wgt-notice-title">{value.title}</p>}
		<div class="wgt-notice-content">
			<PortableText value={value.body} />
		</div>
	</div>
</aside>

<style>
	.wgt-notice {
		display: flex;
		gap: var(--spacing-sm, 0.75rem);
		margin-block: var(--spacing-xl, 2rem);
		padding: var(--spacing-md, 1rem) var(--spacing-lg, 1.5rem);
		border: 1px solid var(--wgt-notice-border);
		border-left-width: 3px;
		border-radius: var(--radius, 10px);
		background: var(--wgt-notice-bg);
	}

	.wgt-notice-icon {
		flex-shrink: 0;
		width: 1.25rem;
		height: 1.25rem;
		margin-top: 0.15em;
		color: var(--wgt-notice-icon);
	}

	.wgt-notice-icon :global(svg) {
		width: 100%;
		height: 100%;
		display: block;
	}

	.wgt-notice-body {
		flex: 1;
		min-width: 0;
	}

	.wgt-notice-title {
		font-weight: 700;
		color: var(--wgt-notice-title);
		margin-bottom: var(--spacing-xs, 0.25rem);
	}

	.wgt-notice-content {
		color: var(--wgt-notice-text);
		font-size: var(--font-size-sm, 0.875rem);
		line-height: 1.6;
	}

	.wgt-notice-content :global(p) {
		margin: 0 0 var(--spacing-sm, 0.75rem);
	}
	.wgt-notice-content :global(p:last-child) {
		margin-bottom: 0;
	}

	.wgt-notice-info {
		--wgt-notice-bg: color-mix(in srgb, var(--color-brand, #4f46e5) 6%, transparent);
		--wgt-notice-border: color-mix(in srgb, var(--color-brand, #4f46e5) 30%, transparent);
		--wgt-notice-icon: var(--color-brand, #4f46e5);
		--wgt-notice-title: var(--color-brand-strong, #3730a3);
		--wgt-notice-text: var(--color-text, inherit);
	}

	.wgt-notice-success {
		--wgt-notice-bg: color-mix(in srgb, var(--color-success, #15803d) 8%, transparent);
		--wgt-notice-border: color-mix(in srgb, var(--color-success, #15803d) 35%, transparent);
		--wgt-notice-icon: var(--color-success, #15803d);
		--wgt-notice-title: var(--color-success, #15803d);
		--wgt-notice-text: var(--color-text, inherit);
	}

	.wgt-notice-warning {
		--wgt-notice-bg: color-mix(in srgb, var(--color-warning, #b45309) 9%, transparent);
		--wgt-notice-border: color-mix(in srgb, var(--color-warning, #b45309) 35%, transparent);
		--wgt-notice-icon: var(--color-warning, #b45309);
		--wgt-notice-title: var(--color-warning, #b45309);
		--wgt-notice-text: var(--color-text, inherit);
	}

	.wgt-notice-danger {
		--wgt-notice-bg: color-mix(in srgb, var(--color-danger, #b91c1c) 8%, transparent);
		--wgt-notice-border: color-mix(in srgb, var(--color-danger, #b91c1c) 35%, transparent);
		--wgt-notice-icon: var(--color-danger, #b91c1c);
		--wgt-notice-title: var(--color-danger, #b91c1c);
		--wgt-notice-text: var(--color-text, inherit);
	}
</style>
