---
import { getHubEntries } from "../../lib/hub-content";
import { Icon } from "astro-iconset/components";
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { hostOf, labelize } from "../../lib/format";
import { linkAttrs } from "../../lib/links";
import NewTab from "../NewTab.astro";
import FilterBar from "./FilterBar.astro";
import SectionHeader from "./SectionHeader.astro";
import SectionLink from "./SectionLink.astro";

type TutorialsBlock = Extract<PageContentBlock, { _type: "site_tutorials" }>;
type Props = BlockComponentProps<TutorialsBlock>;

const { value } = Astro.props;
const { anchor_id, headline, subheadline, show_filters } = value;

const tutorials = await getHubEntries(Astro, "tutorials", value);

const topics = [...new Set(tutorials.map((entry) => entry.data.topic).filter(Boolean))].map((topic) => ({
	value: topic as string,
	label: labelize(topic),
}));
---

<section class="section" id={anchor_id || undefined}>
	<div class="container" data-filter-root>
		<SectionHeader headline={headline} subheadline={subheadline} meta="Guides" />
		{show_filters && <FilterBar options={topics} label="Filter tutorials by topic" />}

		{
			tutorials.length > 0 ? (
				<div class="tut-index">
					{tutorials.map((entry, i) => {
						const link = linkAttrs(entry.data.url);
						const host = hostOf(entry.data.url) || "the site";
						return (
							<article class="tut-row" data-filter-item data-filter-value={entry.data.topic}>
								<span class="tut-no" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
								<div class="tut-body">
									<div class="badges">
										{entry.data.topic && <span class="badge">{labelize(entry.data.topic)}</span>}
										{entry.data.level && <span class="badge badge-muted">{labelize(entry.data.level)}</span>}
										{entry.data.featured && <span class="badge badge-featured">Featured</span>}
									</div>
									<div class="tut-line">
										<h3 class="tut-title">
											<a href={link.href} target={link.target} rel={link.rel} class="card-link">
												{entry.data.title}
												{link.target === "_blank" && <><span class="ext-arrow" aria-hidden="true">↗</span><NewTab /></>}
											</a>
										</h3>
										<span class="tut-leader" aria-hidden="true" />
										<span class="tut-meta">
											<Icon name="ph:book-open-text" width={13} height={13} aria-hidden="true" />
											{host}
										</span>
									</div>
									{entry.data.summary && <p class="tut-summary">{entry.data.summary}</p>}
								</div>
							</article>
						);
					})}
				</div>
			) : (
				<p class="empty-note">No tutorials published yet.</p>
			)
		}

		<SectionLink label={value.section_cta_label} url={value.section_cta_url} />
	</div>
</section>

<style>
	/*
	 * The guides index: a magazine table of contents. Oversized chapter
	 * numerals, serif titles, and dotted leaders running to the destination —
	 * typographic instead of card-based, so it reads differently from the
	 * posts shelf and the resources ledger.
	 */
	.tut-index {
		border-top: var(--line-ink) solid var(--color-border);
	}

	.tut-row {
		position: relative;
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 1fr);
		gap: var(--spacing-lg);
		padding: var(--spacing-xl) var(--spacing-md);
		border-bottom: var(--line-hair) solid var(--color-border);
		transition: background var(--transition-fast);
	}

	.tut-row:hover {
		background: color-mix(in srgb, var(--color-brand) 4%, transparent);
	}

	.tut-no {
		font-family: var(--font-heading);
		font-size: var(--font-size-4xl);
		font-weight: 800;
		font-style: italic;
		line-height: 0.85;
		color: color-mix(in srgb, var(--color-accent-text) 65%, transparent);
		font-variant-numeric: tabular-nums;
		transition: color var(--transition-fast);
	}

	.tut-row:hover .tut-no {
		color: var(--color-accent-text);
	}

	.tut-body {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
	}

	.tut-line {
		display: flex;
		align-items: baseline;
		gap: var(--spacing-md);
	}

	.tut-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-2xl);
		line-height: 1.25;
		text-wrap: pretty;
	}

	.tut-title .card-link {
		color: inherit;
		text-decoration: none;
	}

	.tut-title .card-link::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	.tut-row:hover .tut-title {
		color: var(--color-brand-strong);
	}

	/* inline-block keeps the marker out of the underline on mobile. */
	.ext-arrow {
		display: inline-block;
		margin-left: 0.3em;
		font-family: var(--font-body);
		font-size: 0.65em;
		font-style: normal;
		vertical-align: 0.15em;
		color: var(--color-accent-text);
	}

	.tut-leader {
		flex: 1;
		min-width: 2rem;
		border-bottom: 2px dotted color-mix(in srgb, var(--color-muted) 40%, transparent);
		transform: translateY(-0.35em);
	}

	.tut-meta {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-muted);
		white-space: nowrap;
		transition: color var(--transition-fast);
	}

	.tut-row:hover .tut-meta {
		color: var(--color-accent-text);
	}

	.tut-summary {
		max-width: 60ch;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	@media (max-width: 640px) {
		.tut-row {
			grid-template-columns: 2.5rem minmax(0, 1fr);
			gap: var(--spacing-md);
			padding: var(--spacing-lg) 0;
		}

		.tut-no {
			font-size: var(--font-size-2xl);
		}

		.tut-line {
			flex-wrap: wrap;
			gap: var(--spacing-xs) var(--spacing-md);
		}

		.tut-leader {
			display: none;
		}

		.tut-meta {
			flex-basis: 100%;
		}
	}
</style>
