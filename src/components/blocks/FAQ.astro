---
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type FAQBlock = Extract<PageContentBlock, { _type: "marketing_faq" }>;
type Props = BlockComponentProps<FAQBlock>;

const { value } = Astro.props;
const { anchor_id, headline, items } = value;
---

<section class="faq section" id={anchor_id || undefined}>
	<div class="container">
		{headline && (
			<header class="section-header">
				<p class="section-meta">Notes</p>
				<h2 class="section-headline">{headline}</h2>
			</header>
		)}
		<div class="faq-list">
			{items.map((item, i) => (
				<details class="faq-item" name="faq">
					<summary class="faq-question">
						<span class="faq-no" aria-hidden="true">N{i + 1}</span>
						<span class="faq-q">{item.question}</span>
						<svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M6 9l6 6 6-6" />
						</svg>
					</summary>
					<div class="faq-answer">
						<p>{item.answer}</p>
					</div>
				</details>
			))}
		</div>
	</div>
</section>

<style>
	/* Notes: numbered like drawing notes, hairline rules, no cards. */
	.faq-list {
		--faq-no-width: 2rem;
		max-width: 44rem;
		display: flex;
		flex-direction: column;
		border-bottom: var(--line-hair) solid var(--color-border);
	}

	.faq-item {
		background: transparent;
		border-top: var(--line-hair) solid var(--color-border);
		transition: background var(--transition-fast);
	}

	.faq-item:hover {
		background: color-mix(in srgb, var(--color-brand) 3%, transparent);
	}

	.faq-item[open] {
		background: color-mix(in srgb, var(--color-brand) 4%, transparent);
	}

	.faq-question {
		display: flex;
		align-items: baseline;
		gap: var(--spacing-md);
		padding: var(--spacing-lg) var(--spacing-sm);
		font-family: var(--font-heading);
		font-size: var(--font-size-base);
		font-weight: 600;
		cursor: pointer;
		list-style: none;
	}

	.faq-question::-webkit-details-marker {
		display: none;
	}

	/* Fixed-width tag column, so answers indent to the question text. */
	.faq-no {
		flex: 0 0 var(--faq-no-width);
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 500;
		letter-spacing: 0.05em;
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}

	.faq-q {
		flex: 1;
	}

	.faq-icon {
		width: 20px;
		height: 20px;
		flex-shrink: 0;
		align-self: center;
		color: var(--color-brand-strong);
		transition: transform var(--transition-base);
	}

	.faq-item[open] .faq-icon {
		transform: rotate(180deg);
	}

	.faq-answer {
		padding: 0 var(--spacing-sm) var(--spacing-lg)
			calc(var(--spacing-sm) + var(--faq-no-width) + var(--spacing-md));
	}

	.faq-answer p {
		max-width: 62ch;
		font-size: var(--font-size-base);
		color: var(--color-muted);
		line-height: var(--leading-relaxed);
	}
</style>
