---
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { optionalLink } from "../../lib/links";
import NewTab from "../NewTab.astro";

type CtaBlock = Extract<PageContentBlock, { _type: "site_cta" }>;
type Props = BlockComponentProps<CtaBlock>;

const { value } = Astro.props;
const { anchor_id, headline, subheadline } = value;
const gradient = (value.style ?? "gradient") === "gradient";
const primary = optionalLink(value.primary_cta_label, value.primary_cta_url);
const secondary = optionalLink(value.secondary_cta_label, value.secondary_cta_url);
---

<section class="section cta-section" id={anchor_id || undefined}>
	<div class="container">
		<div class:list={["cta-banner", { "cta-gradient": gradient }]}>
			{gradient && (
				<div class="cta-stamp" aria-hidden="true">
					<span>EmDash</span>
					<span>HQ</span>
				</div>
			)}
			<div class="cta-text">
				<h2 class="cta-headline">{headline}</h2>
				{subheadline && <p class="cta-sub">{subheadline}</p>}
			</div>
			{
				(primary || secondary) && (
					<div class="cta-actions">
						{primary && (
							<a
								href={primary.href}
								target={primary.target}
								rel={primary.rel}
								class:list={["btn btn-lg", gradient ? "btn-on-gradient" : "btn-primary"]}
							>
								{primary.label}
								{primary.target === "_blank" && <NewTab />}
							</a>
						)}
						{secondary && (
							<a
								href={secondary.href}
								target={secondary.target}
								rel={secondary.rel}
								class:list={["btn btn-lg", gradient ? "btn-outline-on-gradient" : "btn-secondary"]}
							>
								{secondary.label}
								{secondary.target === "_blank" && <NewTab />}
							</a>
						)}
					</div>
				)
			}
		</div>
	</div>
</section>

<style>
	.cta-section {
		padding: var(--spacing-3xl) 0;
	}

	/*
	 * The back-cover panel: a paper card, or the ink plate with a
	 * postal stamp when the banner runs dark.
	 */
	.cta-banner {
		position: relative;
		display: grid;
		grid-template-columns: 1.4fr auto;
		align-items: center;
		gap: var(--spacing-2xl);
		padding: clamp(var(--spacing-xl), 5vw, var(--spacing-3xl));
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
		overflow: hidden;
	}

	.cta-banner::before {
		content: "";
		position: absolute;
		top: 18px;
		left: 0;
		width: 42px;
		height: 5px;
		background: var(--color-accent);
		border-radius: 0 40% 40% 0;
		transform: rotate(-1.5deg);
		pointer-events: none;
	}

	.cta-gradient {
		color: var(--color-plate-ink);
		background: var(--color-plate);
		border: 1px solid var(--color-plate-border);
		box-shadow: var(--shadow-xl);
	}

	.cta-gradient::before {
		display: none;
	}

	/* The postal stamp on the banner's edge, like the covers' SENT mark. */
	.cta-stamp {
		position: absolute;
		top: -18px;
		right: 8%;
		width: 82px;
		height: 82px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 2px;
		font-family: var(--font-heading);
		font-size: 0.85rem;
		font-weight: 700;
		font-style: italic;
		line-height: 1.15;
		color: var(--color-accent-soft);
		background: transparent;
		border: 2px solid var(--color-accent);
		border-radius: 50%;
		box-shadow: inset 0 0 0 3px var(--color-plate), inset 0 0 0 4px color-mix(in srgb, var(--color-accent) 55%, transparent);
		transform: rotate(10deg);
		opacity: 0.9;
		pointer-events: none;
		z-index: 0;
	}

	.cta-text {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}

	.cta-headline {
		max-width: 24ch;
		font-family: var(--font-heading);
		font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-3xl));
		font-weight: var(--font-weight-display);
		line-height: 1.15;
		text-wrap: balance;
	}

	.cta-gradient .cta-headline {
		color: var(--color-plate-ink);
	}

	.cta-sub {
		max-width: 52ch;
		font-size: var(--font-size-lg);
		color: var(--color-muted);
		text-wrap: pretty;
	}

	.cta-gradient .cta-sub {
		color: var(--color-plate-muted);
	}

	.cta-actions {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
		min-width: 220px;
	}

	.cta-actions .btn {
		width: 100%;
	}

	/* Paper labels on the ink plate */
	.btn-on-gradient {
		color: var(--color-plate);
		background: var(--color-plate-ink);
		border: 1.5px solid var(--color-plate-ink);
		font-weight: 700;
		box-shadow: var(--shadow);
		transition:
			background var(--transition-fast),
			border-color var(--transition-fast),
			color var(--transition-fast),
			transform var(--transition-fast),
			box-shadow var(--transition-fast);
	}

	.btn-on-gradient:hover {
		background: var(--color-plate-ink-bright);
		border-color: var(--color-plate-ink-bright);
		color: var(--color-plate);
		transform: translateY(-1px);
		box-shadow: var(--shadow-lg);
	}

	.btn-outline-on-gradient {
		color: var(--color-plate-ink);
		border: 1.5px solid color-mix(in srgb, var(--color-plate-ink) 45%, transparent);
		background: color-mix(in srgb, var(--color-plate-ink) 8%, transparent);
		font-weight: 600;
		transition:
			background var(--transition-fast),
			border-color var(--transition-fast),
			transform var(--transition-fast);
	}

	.btn-outline-on-gradient:hover {
		background: color-mix(in srgb, var(--color-plate-ink) 16%, transparent);
		border-color: var(--color-plate-ink);
		transform: translateY(-1px);
	}

	@media (max-width: 800px) {
		.cta-banner {
			grid-template-columns: 1fr;
			text-align: left;
		}

		.cta-actions {
			min-width: 0;
		}
	}
</style>
