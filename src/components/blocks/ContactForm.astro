---
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import SectionHeader from "./SectionHeader.astro";

type FormBlock = Extract<PageContentBlock, { _type: "contact_form" }>;
type Props = BlockComponentProps<FormBlock>;

interface PublicFormField {
	key: string;
	label: string;
	type: "text" | "email" | "tel" | "url" | "number" | "textarea" | "select" | "checkbox";
	required?: boolean;
	placeholder?: string;
	options?: string[];
	help?: string;
}
interface PublicForm {
	slug: string;
	name: string;
	description?: string;
	submitLabel?: string;
	successMessage?: string;
	fields: PublicFormField[];
	turnstileSiteKey?: string;
}

const { value } = Astro.props;
const { anchor_id, headline, subheadline, form: slug } = value;

// Resolve the form in-process through the plugin route registry — no HTTP
// roundtrip, and the same path the browser posts to serves the definition.
const PLUGIN_ID = "emdashhq-contact-forms";
let form: PublicForm | null = null;
const emdash = Astro.locals.emdash;
if (emdash?.handlePublicPluginApiRoute && slug) {
	const res = await emdash.handlePublicPluginApiRoute(
		PLUGIN_ID,
		"GET",
		"form",
		new Request(`${Astro.url.origin}/_emdash/api/plugins/${PLUGIN_ID}/form?slug=${encodeURIComponent(slug)}`),
	);
	if (res.success && res.data && typeof res.data === "object") {
		form = (res.data as { form?: PublicForm }).form ?? null;
	}
}

// The rendered page depends on this form's definition; the middleware purges
// the tag when the plugin's forms or settings change.
if (Astro.cache.enabled) Astro.cache.set({ tags: ["contact-forms"] });

const params = Astro.url.searchParams;
const forThisForm = Boolean(slug) && params.get("cf") === slug;
const status = forThisForm ? params.get("cf_status") : null;
const invalidFields = new Set((forThisForm ? params.get("cf_fields") : null)?.split(",") ?? []);

// A submission result personalizes this response — opt out of the shared page
// cache so another visitor never sees it.
if (forThisForm) Astro.cache.set(false);

interface FormRecovery {
	formSlug: string;
	values: Record<string, string>;
	errors: Record<string, string>;
}

// The submit route stores rejected drafts server-side and passes a one-time
// id in cf_rid; the record is deleted on read.
let recovery: FormRecovery | null = null;
const rid = forThisForm ? params.get("cf_rid") : null;
if (rid && emdash?.handlePublicPluginApiRoute) {
	try {
		const res = await emdash.handlePublicPluginApiRoute(
			PLUGIN_ID,
			"GET",
			"recovery",
			new Request(
				`${Astro.url.origin}/_emdash/api/plugins/${PLUGIN_ID}/recovery?id=${encodeURIComponent(rid)}`,
			),
		);
		if (res.success && res.data && typeof res.data === "object") {
			const rec = (res.data as { recovery?: FormRecovery }).recovery ?? null;
			if (rec && rec.formSlug === slug) recovery = rec;
		}
	} catch {
		// A failed recovery read just loses the draft — the form still renders.
	}
}
const fieldValues = recovery?.values ?? {};
const fieldErrors = recovery?.errors ?? {};

const submitUrl = `/_emdash/api/plugins/${PLUGIN_ID}/submit`;
const inputId = (key: string) => `cf-${slug}-${key}`;
---

<section class="section" id={anchor_id || undefined}>
	<div class="container">
		{
			form ? (
				<>
					<SectionHeader
						headline={headline || form.name}
						subheadline={subheadline ?? form.description}
						meta="Write to me"
					/>
					<form class="cf-form" method="post" action={submitUrl} novalidate={false}>
						<input type="hidden" name="cf_slug" value={form.slug} />
						<input type="hidden" name="cf_page" value={Astro.url.pathname} />
						<input type="hidden" name="cf_ts" value={Date.now()} />
						<p class="cf-hp" aria-hidden="true">
							<label>
								Leave this field empty
								<input type="text" name="cf_hp" tabindex="-1" autocomplete="off" />
							</label>
						</p>

						{status === "sent" && (
							<p class="cf-note cf-ok" role="status">
								{form.successMessage || "Thanks — your message was sent."}
							</p>
						)}
						{status === "saved" && (
							<p class="cf-note cf-ok" role="status">
								{form.successMessage || "Thanks — your message was received."}
							</p>
						)}
						{status === "invalid" && (
							<p class="cf-note cf-err" role="alert">
								Some fields need attention. Check the highlighted fields and try again.
							</p>
						)}
						{status === "rate_limited" && (
							<p class="cf-note cf-err" role="alert">
								Too many attempts. Please wait a while and try again.
							</p>
						)}
						{status === "challenge" && (
							<p class="cf-note cf-err" role="alert">
								The spam check failed — please try again.
							</p>
						)}
						{status === "unavailable" && (
							<p class="cf-note cf-err" role="alert">
								The spam check is temporarily unavailable — please try again in a moment.
							</p>
						)}
						{status === "error" && (
							<p class="cf-note cf-err" role="alert">
								This form is not accepting submissions right now.
							</p>
						)}

						<div class="cf-fields">
							{form.fields.map((field) => {
								const invalid = invalidFields.has(field.key);
								const error = fieldErrors[field.key];
								const submitted = fieldValues[field.key];
								const describedBy =
									[
										error ? `${inputId(field.key)}-err` : null,
										field.help ? `${inputId(field.key)}-help` : null,
									]
										.filter(Boolean)
										.join(" ") || undefined;
								return (
									<p class:list={["cf-field", { "cf-field-bad": invalid }]}>
										<label for={inputId(field.key)}>
											{field.label}
											{field.required && <span class="cf-req" aria-hidden="true"> *</span>}
										</label>
										{field.type === "textarea" ? (
											<textarea
												id={inputId(field.key)}
												name={field.key}
												rows={5}
												required={field.required}
												placeholder={field.placeholder}
												aria-invalid={invalid || undefined}
												aria-describedby={describedBy}
											>{submitted ?? ""}</textarea>
										) : field.type === "select" ? (
											<select
												id={inputId(field.key)}
												name={field.key}
												required={field.required}
												aria-invalid={invalid || undefined}
												aria-describedby={describedBy}
											>
												<option value="">Choose…</option>
												{(field.options ?? []).map((option) => (
													<option value={option} selected={submitted === option}>{option}</option>
												))}
											</select>
										) : field.type === "checkbox" ? (
											<span class="cf-check">
												<input
													type="checkbox"
													id={inputId(field.key)}
													name={field.key}
													required={field.required}
													checked={submitted === "on"}
													aria-invalid={invalid || undefined}
													aria-describedby={describedBy}
												/>
											</span>
										) : (
											<input
												type={
													field.type === "email"
														? "email"
														: field.type === "url"
															? "url"
															: field.type === "tel"
																? "tel"
																: field.type === "number"
																	? "number"
																	: "text"
												}
												id={inputId(field.key)}
												name={field.key}
												required={field.required}
												placeholder={field.placeholder}
												value={submitted}
												aria-invalid={invalid || undefined}
												aria-describedby={describedBy}
											/>
										)}
										{error && (
											<span class="cf-error" id={`${inputId(field.key)}-err`}>{error}</span>
										)}
										{field.help && <span class="cf-help" id={`${inputId(field.key)}-help`}>{field.help}</span>}
									</p>
								);
							})}
						</div>

						{form.turnstileSiteKey && (
							<div class="cf-turnstile" data-sitekey={form.turnstileSiteKey}></div>
						)}

						<button type="submit" class="cf-submit">
							{form.submitLabel || "Send"}
						</button>
					</form>
					{form.turnstileSiteKey && (
						<script
							is:inline
							src="https://challenges.cloudflare.com/turnstile/v0/api.js"
							async
							defer
						></script>
					)}
				</>
			) : (
				<>
					<SectionHeader headline={headline || "Contact"} subheadline={subheadline} meta="Write to me" />
					<p class="cf-note cf-closed">
						This form is not available right now.
					</p>
				</>
			)
		}
	</div>
</section>

{
	/* The 303 reload lands at the page top; focus the first invalid field so
	 * keyboard and screen-reader users land on the problem, else scroll the
	 * status note into view. */
	status && (
		<script>
			const bad = document.querySelector(".cf-form [aria-invalid='true']");
			if (bad instanceof HTMLElement) bad.focus();
			else document.querySelector(".cf-note")?.scrollIntoView({ block: "center" });
		</script>
	)
}

<style>
	.cf-form {
		max-width: 36rem;
	}

	.cf-fields {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-lg);
		margin: var(--spacing-xl) 0;
	}

	.cf-field {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xs);
		margin: 0;
	}

	.cf-field > label {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.cf-req {
		color: var(--color-accent-text);
	}

	.cf-field input:not([type="checkbox"]),
	.cf-field textarea,
	.cf-field select {
		font: inherit;
		font-size: var(--font-size-base);
		color: var(--color-text);
		background: var(--color-surface);
		border: var(--line-hair) solid var(--color-border);
		border-radius: var(--radius);
		padding: var(--spacing-sm) var(--spacing-md);
		box-shadow: var(--shadow-sm);
		transition:
			border-color var(--transition-base),
			box-shadow var(--transition-base);
	}

	.cf-field input:focus-visible,
	.cf-field textarea:focus-visible,
	.cf-field select:focus-visible {
		outline: none;
		border-color: var(--color-brand-strong);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-brand) 18%, transparent);
	}

	.cf-field textarea {
		resize: vertical;
		min-height: 7rem;
	}

	.cf-check {
		display: flex;
		align-items: center;
		min-height: 1.5rem;
	}

	.cf-check input {
		width: 1.1rem;
		height: 1.1rem;
		accent-color: var(--color-brand-strong);
	}

	.cf-help {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.cf-error {
		font-size: var(--font-size-xs);
		font-weight: 600;
		color: var(--color-danger);
	}

	.cf-field-bad input:not([type="checkbox"]),
	.cf-field-bad textarea,
	.cf-field-bad select {
		border-color: var(--color-danger);
	}

	.cf-note {
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		padding: var(--spacing-sm) var(--spacing-md);
		border: var(--line-hair) solid color-mix(in srgb, var(--color-brand-strong) 40%, var(--color-border));
		border-radius: var(--radius);
		background: color-mix(in srgb, var(--color-brand) 6%, var(--color-surface));
	}

	.cf-ok {
		border-color: color-mix(in srgb, var(--color-success) 45%, var(--color-border));
		background: color-mix(in srgb, var(--color-success) 8%, var(--color-surface));
	}

	.cf-err {
		border-color: color-mix(in srgb, var(--color-danger) 50%, var(--color-border));
		background: color-mix(in srgb, var(--color-danger) 7%, var(--color-surface));
	}

	.cf-closed {
		max-width: 36rem;
		color: var(--color-muted);
	}

	.cf-turnstile {
		margin-bottom: var(--spacing-lg);
	}

	.cf-hp {
		position: absolute;
		left: -100vw;
		width: 1px;
		height: 1px;
		overflow: hidden;
		margin: 0;
	}

	.cf-submit {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px; /* 44px touch target */
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-on-control);
		background: var(--color-control);
		border: 1.5px solid var(--color-control);
		border-radius: var(--radius);
		padding: var(--spacing-sm) var(--spacing-xl);
		box-shadow: var(--shadow-sm);
		cursor: pointer;
		transition:
			background var(--transition-fast),
			transform var(--transition-fast),
			box-shadow var(--transition-fast);
	}

	.cf-submit:hover {
		background: var(--color-control-hover);
		border-color: var(--color-control-hover);
		transform: translateY(-1px);
		box-shadow: var(--shadow);
	}
</style>
