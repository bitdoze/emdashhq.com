---
import { getHubEntries } from "../../lib/hub-content";
import { Icon } from "astro-iconset/components";
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { hostOf, labelize } from "../../lib/format";
import { linkAttrs } from "../../lib/links";
import NewTab from "../NewTab.astro";
import FilterBar from "./FilterBar.astro";
import SectionHeader from "./SectionHeader.astro";
import SectionLink from "./SectionLink.astro";

type TutorialsBlock = Extract<PageContentBlock, { _type: "site_tutorials" }>;
type Props = BlockComponentProps<TutorialsBlock>;

const { value } = Astro.props;
const { anchor_id, headline, subheadline, show_filters } = value;

const tutorials = await getHubEntries(Astro, "tutorials", value);

const topics = [...new Set(tutorials.map((entry) => entry.data.topic).filter(Boolean))].map((topic) => ({
	value: topic as string,
	label: labelize(topic),
}));
---

<section class="section" id={anchor_id || undefined}>
	<div class="container" data-filter-root>
		<SectionHeader headline={headline} subheadline={subheadline} meta="Guides" />
		{show_filters && <FilterBar options={topics} label="Filter tutorials by topic" />}

		{
			tutorials.length > 0 ? (
				<ol class="tutorial-index">
					{tutorials.map((entry, i) => {
						const link = linkAttrs(entry.data.url);
						return (
							<li class="tutorial-row" data-filter-item data-filter-value={entry.data.topic}>
								<span class="row-no" aria-hidden="true">
									{String(i + 1).padStart(2, "0")}
								</span>
								<div class="row-body">
									<div class="badges">
										{entry.data.topic && <span class="badge">{labelize(entry.data.topic)}</span>}
										{entry.data.level && <span class="badge badge-muted">{labelize(entry.data.level)}</span>}
									</div>
									<h3 class="tutorial-title">
										<a href={link.href} target={link.target} rel={link.rel} class="card-link">
											{entry.data.title}
											{link.target === "_blank" && <><span class="ext-arrow" aria-hidden="true">↗</span><NewTab /></>}
										</a>
									</h3>
									{entry.data.summary && <p class="tutorial-summary">{entry.data.summary}</p>}
								</div>
								<span class="row-source">
									Read on {hostOf(entry.data.url) || "the site"}
									<Icon name="ph:arrow-right" aria-hidden="true" />
								</span>
							</li>
						);
					})}
				</ol>
			) : (
				<p class="empty-note">No tutorials published yet.</p>
			)
		}

		<SectionLink label={value.section_cta_label} url={value.section_cta_url} />
	</div>
</section>

<style>
	/*
	 * The contents page: numbered rows like a magazine table of contents.
	 */
	.tutorial-index {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}

	/* Positioned so the stretched .card-link overlay stays inside its row. */
	.tutorial-row {
		position: relative;
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: var(--spacing-lg);
		align-items: center;
		padding: var(--spacing-lg);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm);
		transition:
			border-color var(--transition-base),
			transform var(--transition-base),
			box-shadow var(--transition-base);
	}

	.tutorial-row:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--color-brand) 45%, var(--color-border));
		box-shadow: var(--shadow-lg);
	}

	.row-no {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		font-family: var(--font-heading);
		font-size: var(--font-size-sm);
		font-weight: 800;
		font-style: italic;
		color: var(--color-accent-text);
		background: color-mix(in srgb, var(--color-accent) 10%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
		border-radius: 50%;
		font-variant-numeric: tabular-nums;
		flex-shrink: 0;
	}

	.row-body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
		min-width: 0;
	}

	.tutorial-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		line-height: 1.3;
		text-wrap: pretty;
	}

	/* inline-block keeps the marker out of the underline on mobile. */
	.ext-arrow {
		display: inline-block;
		margin-left: 0.3em;
		font-family: var(--font-body);
		font-size: 0.65em;
		font-style: normal;
		vertical-align: 0.15em;
		color: var(--color-accent-text);
	}

	.tutorial-summary {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		max-width: 68ch;
	}

	.row-source {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		white-space: nowrap;
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-brand-strong);
		padding: 6px 14px;
		background: color-mix(in srgb, var(--color-brand) 6%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-brand) 22%, transparent);
		border-radius: var(--radius-full);
		transition:
			background var(--transition-fast),
			color var(--transition-fast),
			border-color var(--transition-fast);
	}

	.row-source :global(svg) {
		transition: transform var(--transition-base);
	}

	.tutorial-row:hover .row-source {
		background: var(--color-brand-strong);
		color: var(--color-on-brand);
		border-color: var(--color-brand-strong);
	}

	.tutorial-row:hover .row-source :global(svg) {
		transform: translateX(3px);
	}

	@media (max-width: 700px) {
		.tutorial-row {
			grid-template-columns: auto 1fr;
			align-items: start;
		}

		.row-source {
			display: none;
		}

		/* With the host pill hidden, the title carries the affordance. */
		.tutorial-title a {
			text-decoration: underline;
			text-decoration-color: var(--color-accent);
			text-decoration-thickness: 1.5px;
			text-underline-offset: 4px;
		}
	}
</style>
