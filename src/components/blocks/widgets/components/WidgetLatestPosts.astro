---
/**
 * widget_latest_posts — newest published entries in a collection, resolved
 * in-process through the Widgets plugin's public `posts` route. Copy into
 * your site's components and register it for the `widget_latest_posts`
 * block type (see README).
 */
import { getWidgetPosts } from "./config";

type Props = {
	value: {
		heading?: string | null;
		collection?: string | null;
		limit?: number | null;
		exclude_current?: boolean | null;
	};
};

const { value } = Astro.props;

// "Exclude current" treats the last path segment as the entry slug — right
// for /blog/{slug} url patterns, harmless on index pages.
const currentSlug = value.exclude_current !== false
	? Astro.url.pathname.replace(/\/+$/, "").split("/").pop() ?? ""
	: "";

const posts = await getWidgetPosts(Astro, {
	collection: value.collection || undefined,
	limit: value.limit ?? 5,
	exclude: currentSlug,
});

function formatDate(iso: string | undefined): string | null {
	if (!iso) return null;
	const date = new Date(iso);
	return Number.isNaN(date.getTime())
		? null
		: date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}
---

{
	posts.length > 0 && (
		<aside class="wgt-latest">
			<p class="wgt-latest-title">{value.heading || "Keep reading"}</p>
			<ul class="wgt-latest-list">
				{posts.map((post) => (
					<li>
						<a href={post.url}>{post.title}</a>
						{formatDate(post.publishedAt) && (
							<time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
						)}
					</li>
				))}
			</ul>
		</aside>
	)
}

<style>
	.wgt-latest {
		margin-block: var(--spacing-xl, 2rem);
		padding: var(--spacing-lg, 1.5rem);
		border: 1px solid var(--color-border, #e2e0d8);
		border-radius: var(--radius, 10px);
		background: color-mix(in srgb, var(--color-surface, #fff) 70%, transparent);
	}

	.wgt-latest-title {
		font-size: var(--font-size-xs, 0.75rem);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-muted, #666);
		margin: 0 0 var(--spacing-sm, 0.75rem);
	}

	.wgt-latest-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--spacing-sm, 0.75rem);
	}

	.wgt-latest-list li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--spacing-md, 1rem);
		font-size: var(--font-size-sm, 0.875rem);
	}

	.wgt-latest-list a {
		font-weight: 600;
		color: var(--color-text, inherit);
		text-decoration: none;
	}

	.wgt-latest-list a:hover {
		color: var(--color-brand-strong, #3730a3);
		text-decoration: underline;
	}

	.wgt-latest-list time {
		flex-shrink: 0;
		font-size: var(--font-size-xs, 0.75rem);
		color: var(--color-muted, #666);
	}
</style>
