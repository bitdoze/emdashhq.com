---
import { getHubEntries } from "../../lib/hub-content";
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { labelize } from "../../lib/format";
import { linkAttrs } from "../../lib/links";
import FilterBar from "./FilterBar.astro";
import NewTab from "../NewTab.astro";
import SectionHeader from "./SectionHeader.astro";
import SectionLink from "./SectionLink.astro";

type ResourcesBlock = Extract<PageContentBlock, { _type: "site_resources" }>;
type Props = BlockComponentProps<ResourcesBlock>;

const { value } = Astro.props;
const { anchor_id, headline, subheadline, show_filters } = value;

const resources = await getHubEntries(Astro, "resources", value);

const priceOptions = [...new Set(resources.map((entry) => entry.data.price_type))].map((type) => ({
	value: type,
	label: labelize(type),
}));
---

<section class="section" id={anchor_id || undefined}>
	<div class="container" data-filter-root>
		<SectionHeader headline={headline} subheadline={subheadline} meta="Catalog" />
		{show_filters && <FilterBar options={priceOptions} label="Filter by price" />}

		{
			resources.length > 0 ? (
				<div class="card-grid">
					{resources.map((entry) => {
						const link = linkAttrs(entry.data.url);
						const demo = entry.data.demo_url ? linkAttrs(entry.data.demo_url) : undefined;
						const isPaid = entry.data.price_type === "paid";
						return (
							<article class="hub-card resource-card" data-filter-item data-filter-value={entry.data.price_type}>
								{entry.data.image && (
									<div class="resource-media-wrap">
										<Image image={entry.data.image} class="resource-shot" />
									</div>
								)}
								<div class="resource-body">
									<div class="badges">
										<span class="badge badge-muted">{labelize(entry.data.kind)}</span>
										<span class:list={["badge", isPaid ? "badge-paid" : "badge-free"]}>
											{isPaid && entry.data.price ? `Paid, ${entry.data.price}` : labelize(entry.data.price_type)}
										</span>
									</div>
									<h3 class="resource-title">{entry.data.title}</h3>
									{entry.data.summary && <p class="resource-summary">{entry.data.summary}</p>}
									<div class="resource-actions">
										<a href={link.href} target={link.target} rel={link.rel} class="btn btn-primary">
											{entry.data.cta_label || "View"}
											{link.target === "_blank" && <NewTab />}
										</a>
										{demo && (
											<a href={demo.href} target={demo.target} rel={demo.rel} class="btn btn-secondary">
												Demo
												{demo.target === "_blank" && <NewTab />}
											</a>
										)}
									</div>
								</div>
							</article>
						);
					})}
				</div>
			) : (
				<p class="empty-note">Nothing listed here yet.</p>
			)
		}

		{
			/* A lone card or two in a three-column shelf reads as broken;
			   say it's the whole shelf instead. */
			resources.length > 0 && resources.length <= 2 && (
				<p class="empty-note">That's the whole shelf for now. New themes and plugins land here as they ship.</p>
			)
		}

		<SectionLink label={value.section_cta_label} url={value.section_cta_url} />
	</div>
</section>

<style>
	.resource-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border-radius: var(--radius-lg);
	}

	.resource-media-wrap {
		position: relative;
		overflow: hidden;
		border-bottom: 1px solid var(--color-border);
		background: color-mix(in srgb, var(--color-surface) 60%, transparent);
	}

	.resource-card :global(.resource-shot) {
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		transition: transform 0.4s cubic-bezier(0.2, 0, 0.2, 1);
	}

	.resource-card:hover :global(.resource-shot) {
		transform: scale(1.04);
	}

	.resource-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: var(--spacing-sm);
		padding: var(--spacing-xl);
	}

	.resource-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		line-height: 1.3;
		text-wrap: pretty;
	}

	.resource-summary {
		flex: 1;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.resource-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
		margin-top: var(--spacing-md);
	}
</style>
