---
import { getEmDashCollection } from "emdash";
import { Icon } from "astro-iconset/components";
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { hostOf, labelize } from "../../lib/format";
import { linkAttrs } from "../../lib/links";
import FilterBar from "./FilterBar.astro";
import SectionHeader from "./SectionHeader.astro";
import SectionLink from "./SectionLink.astro";

type TutorialsBlock = Extract<PageContentBlock, { _type: "site_tutorials" }>;
type Props = BlockComponentProps<TutorialsBlock>;

const { value } = Astro.props;
const { anchor_id, headline, subheadline, featured_only, show_filters } = value;
const limit = value.limit ?? 6;

const { entries } = await getEmDashCollection("tutorials", {
	status: "published",
	orderBy: { published_at: "desc" },
	limit: 100,
});

let tutorials = featured_only ? entries.filter((entry) => entry.data.featured) : entries;
if (limit > 0) tutorials = tutorials.slice(0, limit);

const topics = [...new Set(tutorials.map((entry) => entry.data.topic).filter(Boolean))].map((topic) => ({
	value: topic as string,
	label: labelize(topic),
}));
---

<section class="section" id={anchor_id || undefined}>
	<div class="container" data-filter-root>
		<SectionHeader headline={headline} subheadline={subheadline} meta="Set index" />
		{show_filters && <FilterBar options={topics} label="Filter tutorials by topic" />}

		{
			tutorials.length > 0 ? (
				<ol class="tutorial-index">
					{tutorials.map((entry, i) => {
						const link = linkAttrs(entry.data.url);
						return (
							<li class="tutorial-row" data-filter-item data-filter-value={entry.data.topic}>
								<span class="row-no" aria-hidden="true">
									{String(i + 1).padStart(2, "0")}
								</span>
								<div class="row-body">
									<div class="badges">
										{entry.data.topic && <span class="badge">{labelize(entry.data.topic)}</span>}
										{entry.data.level && <span class="badge badge-muted">{labelize(entry.data.level)}</span>}
									</div>
									<h3 class="tutorial-title">
										<a href={link.href} target={link.target} rel={link.rel} class="card-link">
											{entry.data.title}
										</a>
									</h3>
									{entry.data.summary && <p class="tutorial-summary">{entry.data.summary}</p>}
								</div>
								<span class="row-source">
									Read on {hostOf(entry.data.url) || "the site"}
									<Icon name="ph:arrow-right" aria-hidden="true" />
								</span>
							</li>
						);
					})}
				</ol>
			) : (
				<p class="empty-note">No tutorials published yet.</p>
			)
		}

		<SectionLink label={value.section_cta_label} url={value.section_cta_url} />
	</div>
</section>

<style>
	/*
	 * The set index: elevated interactive cards with numbered index badges
	 */
	.tutorial-index {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
	}

	/* Positioned so the stretched .card-link overlay stays inside its row. */
	.tutorial-row {
		position: relative;
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: var(--spacing-lg);
		align-items: center;
		padding: var(--spacing-lg);
		background: var(--gradient-card);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		box-shadow: var(--shadow-sm), inset 0 1px 0 0 var(--color-highlight);
		transition:
			border-color var(--transition-base),
			background var(--transition-base),
			transform var(--transition-base),
			box-shadow var(--transition-base);
	}

	.tutorial-row:hover {
		transform: translateX(4px);
		border-color: color-mix(in srgb, var(--color-brand) 60%, var(--color-border));
		background: color-mix(in srgb, var(--color-brand) 4%, var(--color-surface));
		box-shadow: var(--shadow), 0 0 16px -4px color-mix(in srgb, var(--color-brand) 20%, transparent);
	}

	.row-no {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 600;
		color: var(--color-brand-strong);
		background: color-mix(in srgb, var(--color-brand) 8%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-brand) 25%, transparent);
		border-radius: var(--radius-sm);
		font-variant-numeric: tabular-nums;
		flex-shrink: 0;
	}

	.row-body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
		min-width: 0;
	}

	.tutorial-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		line-height: 1.3;
		text-wrap: pretty;
	}

	.tutorial-summary {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		max-width: 68ch;
	}

	.row-source {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		white-space: nowrap;
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-brand-strong);
		padding: 6px 12px;
		background: color-mix(in srgb, var(--color-brand) 6%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-brand) 20%, transparent);
		border-radius: var(--radius-sm);
		transition:
			background var(--transition-fast),
			color var(--transition-fast),
			border-color var(--transition-fast);
	}

	.row-source :global(svg) {
		transition: transform var(--transition-base);
	}

	.tutorial-row:hover .row-source {
		background: var(--color-brand-strong);
		color: var(--color-on-brand);
		border-color: var(--color-brand-strong);
	}

	.tutorial-row:hover .row-source :global(svg) {
		transform: translateX(3px);
	}

	@media (max-width: 700px) {
		.tutorial-row {
			grid-template-columns: auto 1fr;
			align-items: start;
		}

		.row-source {
			display: none;
		}
	}
</style>
