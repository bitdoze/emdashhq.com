---
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { optionalLink } from "../../lib/links";

type CtaBlock = Extract<PageContentBlock, { _type: "site_cta" }>;
type Props = BlockComponentProps<CtaBlock>;

const { value } = Astro.props;
const { anchor_id, headline, subheadline } = value;
const gradient = (value.style ?? "gradient") === "gradient";
const primary = optionalLink(value.primary_cta_label, value.primary_cta_url);
const secondary = optionalLink(value.secondary_cta_label, value.secondary_cta_url);
---

<section class="section cta-section" id={anchor_id || undefined}>
	<div class="container">
		<div class:list={["cta-banner", { "cta-gradient": gradient }]}>
			<div class="cta-text">
				<h2 class="cta-headline">{headline}</h2>
				{subheadline && <p class="cta-sub">{subheadline}</p>}
			</div>
			{
				(primary || secondary) && (
					<div class="cta-actions">
						{primary && (
							<a
								href={primary.href}
								target={primary.target}
								rel={primary.rel}
								class:list={["btn btn-lg", gradient ? "btn-on-gradient" : "btn-primary"]}
							>
								{primary.label}
							</a>
						)}
						{secondary && (
							<a
								href={secondary.href}
								target={secondary.target}
								rel={secondary.rel}
								class:list={["btn btn-lg", gradient ? "btn-outline-on-gradient" : "btn-secondary"]}
							>
								{secondary.label}
							</a>
						)}
					</div>
				)
			}
		</div>
	</div>
</section>

<style>
	.cta-section {
		padding: var(--spacing-3xl) 0;
	}

	/*
	 * The approval block: the sign-off table from a drawing title
	 * block. Heavy ink frame, inner hairline, flat ground.
	 */
	.cta-banner {
		position: relative;
		display: grid;
		grid-template-columns: 1.4fr auto;
		align-items: center;
		gap: var(--spacing-2xl);
		padding: clamp(var(--spacing-xl), 5vw, var(--spacing-3xl));
		background: var(--gradient-card);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg), inset 0 1px 0 0 var(--color-highlight);
	}

	.cta-banner::before {
		content: "";
		position: absolute;
		inset: 6px;
		border: var(--line-hair) solid color-mix(in srgb, var(--color-brand) 25%, transparent);
		border-radius: var(--radius);
		pointer-events: none;
	}

	.cta-gradient {
		color: #ffffff;
		background:
			radial-gradient(ellipse at 80% 20%, color-mix(in srgb, var(--color-accent) 25%, transparent) 0%, transparent 60%),
			radial-gradient(ellipse at 15% 90%, color-mix(in srgb, var(--color-brand-strong) 40%, transparent) 0%, transparent 65%),
			linear-gradient(145deg, #0f274a 0%, #08172c 100%);
		border: 1px solid color-mix(in srgb, var(--color-brand-strong) 50%, var(--color-border));
		box-shadow:
			var(--shadow-xl),
			0 0 35px -8px color-mix(in srgb, var(--color-brand-strong) 35%, transparent),
			inset 0 1px 0 0 rgba(255, 255, 255, 0.12);
	}

	.cta-gradient::before {
		border-color: rgba(255, 255, 255, 0.15);
	}

	.cta-text {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}

	.cta-headline {
		max-width: 24ch;
		font-family: var(--font-heading);
		font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-3xl));
		font-weight: var(--font-weight-display);
		line-height: 1.15;
		text-wrap: balance;
	}

	.cta-gradient .cta-headline {
		color: #ffffff;
	}

	.cta-sub {
		max-width: 52ch;
		font-size: var(--font-size-lg);
		color: var(--color-muted);
		text-wrap: pretty;
	}

	.cta-gradient .cta-sub {
		color: #cdddf5;
	}

	.cta-actions {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
		min-width: 220px;
	}

	.cta-actions .btn {
		width: 100%;
	}

	/* High-contrast tactile action buttons on gradient CTA */
	.btn-on-gradient {
		color: var(--color-brand-strong);
		background: #ffffff;
		border: 1.5px solid #ffffff;
		font-weight: 700;
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
		transition: all var(--transition-fast);
	}

	.btn-on-gradient:hover {
		background: #eef4ff;
		border-color: #eef4ff;
		color: var(--color-brand-strong);
		transform: translateY(-1px);
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
	}

	.btn-outline-on-gradient {
		color: #ffffff;
		border: 1.5px solid rgba(255, 255, 255, 0.45);
		background: rgba(255, 255, 255, 0.08);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		font-weight: 600;
		transition: all var(--transition-fast);
	}

	.btn-outline-on-gradient:hover {
		background: rgba(255, 255, 255, 0.18);
		border-color: #ffffff;
		transform: translateY(-1px);
	}

	@media (max-width: 800px) {
		.cta-banner {
			grid-template-columns: 1fr;
			text-align: left;
		}

		.cta-actions {
			min-width: 0;
		}
	}
</style>
