---
import { getEmDashEntry, getSeoMeta, getContentSeo } from "emdash";
import MarketingBlocks from "../components/MarketingBlocks.astro";
import Base from "../layouts/Base.astro";
import { getSiteChrome } from "../lib/site-data";
import { preloadHubBlocks } from "../lib/hub-content";
import { unavailableResponse } from "../lib/unavailable";

// One route renders every entry in the pages collection. "/" is the page
// with the slug "home".
const requested = Astro.params.slug;
if (requested === "home") return Astro.redirect(`/${Astro.url.search}`, 301);
if (requested && !Astro.url.pathname.endsWith("/")) {
	return Astro.redirect(`${Astro.url.pathname}/${Astro.url.search}`, 301);
}

const slug = requested ?? "home";
const isHome = slug === "home";

let page: Awaited<ReturnType<typeof getEmDashEntry<"pages">>>["entry"];
const started = performance.now();
try {
	const [result] = await Promise.all([getEmDashEntry("pages", slug), getSiteChrome(Astro)]);
	if (result.error) throw result.error;
	page = result.entry;
	if (Astro.cache.enabled) Astro.cache.set(result.cacheHint);
	await preloadHubBlocks(Astro, page?.data.content ?? []);
} catch (error) {
	console.error("Unable to render CMS page", { slug, error });
	Astro.cache.set(false);
	return unavailableResponse();
}
// The CMS replaces Server-Timing after rendering; keep this measurement separate.
Astro.response.headers.set("X-Site-Data-Ms", (performance.now() - started).toFixed(1));

if (!page && !isHome) return Astro.rewrite("/404");

const seo = page
	? getSeoMeta(page, {
			siteUrl: Astro.url.origin,
			path: isHome ? "/" : `/${slug}/`,
		})
	: null;
---

<Base
	title={isHome ? (page ? getContentSeo(page)?.title || undefined : undefined) : seo?.title}
	pageTitle={page?.data.title}
	description={seo?.description}
	image={seo?.ogImage}
	canonical={seo?.canonical}
	robots={seo?.robots}
	content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
>
	{
		page?.data.content ? (
			<div {...page.edit.content}>
				<MarketingBlocks value={page.data.content} />
			</div>
		) : (
			<div class="empty-state">
				<h1>Welcome to EmDash HQ</h1>
				<p>Add content to the home page in the admin to get started.</p>
				{Astro.locals.user && (
					<a href="/_emdash/admin" class="btn btn-primary">
						Open Admin
					</a>
				)}
			</div>
		)
	}
</Base>

<style>
	.empty-state {
		text-align: center;
		padding: var(--spacing-5xl) var(--spacing-lg);
		max-width: var(--max-width);
		margin: var(--spacing-3xl) auto;
		background: color-mix(in srgb, var(--color-brand) 6%, var(--color-surface));
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	.empty-state h1 {
		font-family: var(--font-heading);
		margin-bottom: var(--spacing-md);
		text-wrap: balance;
	}

	.empty-state p {
		color: var(--color-muted);
		margin-bottom: var(--spacing-xl);
	}
</style>
