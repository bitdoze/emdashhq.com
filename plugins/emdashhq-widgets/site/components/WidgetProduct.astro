---
/**
 * widget_product — review/affiliate card with rating, pros/cons and a buy
 * button. The affiliate disclosure line comes from the plugin settings.
 * Copy into your site's components and register it for the `widget_product`
 * block type (see README).
 */
import { Image } from "emdash/ui";
import { sanitizeHref, type ImageValue } from "emdash";
import { getWidgetConfig } from "./config";
import { widgetIcon } from "./icons";

type Props = {
	value: {
		name: string;
		image?: ImageValue | null;
		rating?: number | null;
		description?: string | null;
		pros?: { text: string }[] | null;
		cons?: { text: string }[] | null;
		price?: string | null;
		url?: string | null;
		cta_label?: string | null;
	};
};

const { value } = Astro.props;
const config = await getWidgetConfig(Astro);
const rating = Math.max(0, Math.min(5, Math.round(value.rating ?? 0)));
const pros = (value.pros ?? []).filter((item) => item?.text);
const cons = (value.cons ?? []).filter((item) => item?.text);
const href = value.url ? sanitizeHref(value.url) : "";
const ctaLabel = value.cta_label || "Check price";
const sponsored = /^https?:\/\//i.test(href);
const image = value.image?.id ? value.image : null;
const checkIcon = widgetIcon("check");
const xIcon = widgetIcon("x");
---

<section class="wgt-product">
	{config.affiliateDisclosure && <p class="wgt-product-disclosure">{config.affiliateDisclosure}</p>}
	<div class:list={["wgt-product-card", image && "wgt-product-has-media"]}>
		{
			image && (
				<div class="wgt-product-media">
					<Image image={image} alt={image.alt || value.name} />
				</div>
			)
		}
		<div class="wgt-product-body">
			<div class="wgt-product-head">
				<h3 class="wgt-product-name">{value.name}</h3>
				{
					rating > 0 && (
						<span class="wgt-product-rating" role="img" aria-label={`Rated ${rating} out of 5`}>
							{Array.from({ length: 5 }, (_, i) => (
								<svg viewBox="0 0 20 20" fill="currentColor" class={i < rating ? "star-on" : "star-off"} aria-hidden="true">
									<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
								</svg>
							))}
						</span>
					)
				}
				{value.price && <span class="wgt-product-price">{value.price}</span>}
			</div>
			{value.description && <p class="wgt-product-desc">{value.description}</p>}
			{
				(pros.length > 0 || cons.length > 0) && (
					<div class="wgt-product-lists">
						{pros.length > 0 && (
							<div class="wgt-product-col">
								<p class="wgt-product-col-title wgt-pros">Pros</p>
								<ul>
									{pros.map((item) => (
										<li>
											<span class="wgt-mark wgt-mark-pro" set:html={checkIcon} />
											{item.text}
										</li>
									))}
								</ul>
							</div>
						)}
						{cons.length > 0 && (
							<div class="wgt-product-col">
								<p class="wgt-product-col-title wgt-cons">Cons</p>
								<ul>
									{cons.map((item) => (
										<li>
											<span class="wgt-mark wgt-mark-con" set:html={xIcon} />
											{item.text}
										</li>
									))}
								</ul>
							</div>
						)}
					</div>
				)
			}
			{
				href && (
					<a class="wgt-product-cta" href={href} target={sponsored ? "_blank" : undefined} rel={sponsored ? "sponsored noopener noreferrer" : undefined}>
						{ctaLabel}
					</a>
				)
			}
		</div>
	</div>
</section>

<style>
	.wgt-product {
		margin-block: var(--spacing-xl, 2rem);
	}

	.wgt-product .wgt-product-disclosure {
		font-family: var(--font-mono, monospace);
		font-size: var(--font-size-xs, 0.75rem);
		letter-spacing: 0.06em;
		color: var(--color-muted, #666);
		margin-bottom: var(--spacing-sm, 0.75rem);
	}

	.wgt-product-card {
		display: grid;
		grid-template-columns: 1fr;
		border: 1px solid var(--color-border, #e2e0d8);
		border-radius: var(--radius-lg, 16px);
		background: var(--color-surface, #fff);
		box-shadow: var(--shadow-sm, 0 1px 3px rgb(0 0 0 / 0.06));
		overflow: hidden;
	}

	/* Without an image the card stays single-column; the media column only
	   appears when a picture is actually set. */
	.wgt-product-has-media {
		grid-template-columns: minmax(0, 190px) 1fr;
	}

	.wgt-product-media {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: var(--spacing-md, 1rem);
		border-right: 1px solid var(--color-border, #e2e0d8);
		background: color-mix(in srgb, var(--color-border, #e2e0d8) 15%, transparent);
	}

	.wgt-product-media :global(img) {
		width: 100%;
		height: auto;
		object-fit: contain;
		max-height: 150px;
	}

	.wgt-product-body {
		padding: var(--spacing-lg, 1.5rem);
		min-width: 0;
	}

	.wgt-product-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-sm, 0.75rem) var(--spacing-md, 1rem);
	}

	/* .post-body h3 brings a large margin-top that would push the name
	   below the stars on the same row — override it with a tighter selector. */
	.wgt-product-head .wgt-product-name {
		font-size: var(--font-size-xl, 1.25rem);
		margin: 0;
	}

	.wgt-product-rating {
		display: inline-flex;
		gap: 2px;
	}

	.wgt-product-rating svg {
		width: 1rem;
		height: 1rem;
	}

	.wgt-product-rating .star-on {
		color: var(--color-warm, #d97706);
	}

	.wgt-product-rating .star-off {
		color: var(--color-border, #d5d3c8);
	}

	.wgt-product-price {
		font-family: var(--font-mono, monospace);
		font-size: var(--font-size-xs, 0.75rem);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-brand-strong, #3730a3);
		border: 1px solid color-mix(in srgb, var(--color-brand-strong, #3730a3) 35%, transparent);
		border-radius: var(--radius-full, 999px);
		padding: 0.25em 0.8em;
		margin-left: auto;
	}

	.wgt-product-body .wgt-product-desc {
		margin: var(--spacing-sm, 0.75rem) 0 0;
		color: var(--color-muted, #555);
		line-height: 1.6;
	}

	.wgt-product-lists {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-md, 1rem);
		margin-top: var(--spacing-md, 1rem);
		border-top: 1px solid var(--color-border, #e2e0d8);
		padding-top: var(--spacing-md, 1rem);
	}

	.wgt-product-col .wgt-product-col-title {
		font-family: var(--font-mono, monospace);
		font-size: var(--font-size-xs, 0.75rem);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin: 0 0 var(--spacing-xs, 0.5rem);
	}

	.wgt-product-col .wgt-product-col-title.wgt-pros {
		color: var(--color-success, #15803d);
	}
	.wgt-product-col .wgt-product-col-title.wgt-cons {
		color: var(--color-danger, #b91c1c);
	}

	.wgt-product-col ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		font-size: var(--font-size-sm, 0.875rem);
		line-height: 1.55;
	}

	.wgt-product-col li {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
	}

	.wgt-mark {
		flex: 0 0 auto;
		display: inline-flex;
		margin-top: 0.2em;
	}

	.wgt-mark :global(svg) {
		width: 0.85em;
		height: 0.85em;
	}

	.wgt-mark-pro {
		color: var(--color-success, #15803d);
	}

	.wgt-mark-con {
		color: var(--color-danger, #b91c1c);
	}

	.wgt-product-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		margin-top: var(--spacing-lg, 1.5rem);
		padding: 0.625rem 1.25rem;
		font-family: var(--font-mono, monospace);
		font-weight: 600;
		font-size: var(--font-size-xs, 0.75rem);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-on-control, #fff);
		background: var(--color-control, #3730a3);
		border-radius: var(--radius, 10px);
		text-decoration: none;
		transition:
			background 0.2s,
			transform 0.15s;
	}

	.wgt-product-cta:hover {
		background: var(--color-brand-strong, #4f46e5);
		transform: translateY(-1px);
	}

	@media (max-width: 640px) {
		.wgt-product-has-media {
			grid-template-columns: 1fr;
		}
		.wgt-product-media {
			border-right: 0;
			border-bottom: 1px solid var(--color-border, #e2e0d8);
		}
		.wgt-product-lists {
			grid-template-columns: 1fr;
		}
		.wgt-product-price {
			margin-left: 0;
		}
	}
</style>
