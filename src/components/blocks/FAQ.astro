---
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type FAQBlock = Extract<PageContentBlock, { _type: "marketing_faq" }>;
type Props = BlockComponentProps<FAQBlock>;

const { value } = Astro.props;
const { anchor_id, headline, items } = value;
---

<section class="faq section" id={anchor_id || undefined}>
	<div class="container">
		{headline && (
			<header class="section-header">
				<p class="section-meta">Q&amp;A</p>
				<h2 class="section-headline">{headline}</h2>
			</header>
		)}
		<div class="faq-list">
			{items.map((item, i) => (
				<details class="faq-item" name="faq">
					<summary class="faq-question">
						<span class="faq-no" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
						<span class="faq-q">{item.question}</span>
						<svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M6 9l6 6 6-6" />
						</svg>
					</summary>
					<div class="faq-answer">
						<p>{item.answer}</p>
					</div>
				</details>
			))}
		</div>
	</div>
</section>

<style>
	.faq-list {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
	}

	.faq-item {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm);
		transition:
			border-color var(--transition-base),
			transform var(--transition-base),
			box-shadow var(--transition-base);
		overflow: hidden;
	}

	.faq-item:hover {
		border-color: color-mix(in srgb, var(--color-brand) 45%, var(--color-border));
		box-shadow: var(--shadow);
	}

	.faq-item[open] {
		border-color: var(--color-brand-strong);
		background: color-mix(in srgb, var(--color-brand) 3%, var(--color-surface));
		box-shadow: var(--shadow);
	}

	.faq-question {
		display: flex;
		align-items: center;
		gap: var(--spacing-md);
		padding: var(--spacing-lg);
		font-family: var(--font-heading);
		font-size: var(--font-size-base);
		font-weight: 600;
		color: var(--color-text);
		cursor: pointer;
		list-style: none;
		user-select: none;
	}

	.faq-question::-webkit-details-marker {
		display: none;
	}

	.faq-no {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		font-family: var(--font-heading);
		font-size: var(--font-size-sm);
		font-weight: 800;
		font-style: italic;
		color: var(--color-accent-text);
		background: color-mix(in srgb, var(--color-accent) 10%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
		border-radius: 50%;
		flex-shrink: 0;
		font-variant-numeric: tabular-nums;
	}

	.faq-q {
		flex: 1;
		line-height: var(--leading-snug);
	}

	.faq-icon {
		width: 20px;
		height: 20px;
		flex-shrink: 0;
		color: var(--color-brand-strong);
		transition: transform var(--transition-base);
	}

	.faq-item[open] .faq-icon {
		transform: rotate(180deg);
	}

	.faq-answer {
		padding: 0 var(--spacing-lg) var(--spacing-lg) calc(var(--spacing-lg) + 34px + var(--spacing-md));
	}

	.faq-answer p {
		max-width: 75ch;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		line-height: var(--leading-relaxed);
		margin: 0;
	}

	@media (max-width: 640px) {
		.faq-question {
			padding: var(--spacing-md);
			gap: var(--spacing-sm);
		}

		.faq-answer {
			padding: 0 var(--spacing-md) var(--spacing-md) calc(var(--spacing-md) + 34px + var(--spacing-sm));
		}
	}
</style>
