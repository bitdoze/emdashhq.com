---
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { lines } from "../../lib/format";
import { linkAttrs } from "../../lib/links";
import SectionHeader from "./SectionHeader.astro";

type PricingBlock = Extract<PageContentBlock, { _type: "marketing_pricing" }>;
type Props = BlockComponentProps<PricingBlock>;

const { value } = Astro.props;
const { anchor_id, headline, plans: rawPlans } = value;

const plans = rawPlans.map((plan) => ({
	...plan,
	features: lines(plan.features),
	cta: {
		label: plan.cta_label,
		...linkAttrs(plan.cta_url),
	},
}));
---

<section class="pricing section" id={anchor_id || undefined}>
	<div class="container">
		<SectionHeader headline={headline} meta="Pricing" />
		<div class="pricing-grid">
			{plans.map((plan) => (
				<div class:list={["pricing-card", { "pricing-highlighted": plan.highlighted }]}>
					{plan.highlighted && <div class="pricing-badge">Most popular</div>}
					<div class="pricing-plan-header">
						<h3 class="pricing-name">{plan.name}</h3>
						<div class="pricing-price">
							<span class="pricing-amount">{plan.price}</span>
							{plan.period && <span class="pricing-period">{plan.period}</span>}
						</div>
						{plan.description && (
							<p class="pricing-description">{plan.description}</p>
						)}
					</div>
					<ul class="pricing-features">
						{plan.features.map((feature) => (
							<li>
								<svg class="check-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
									<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
								</svg>
								{feature}
							</li>
						))}
					</ul>
					<a
						href={plan.cta.href}
						target={plan.cta.target}
						rel={plan.cta.rel}
						class:list={["btn", "btn-lg", "pricing-cta", { "btn-primary": plan.highlighted, "btn-secondary": !plan.highlighted }]}
					>
						{plan.cta.label}
					</a>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.pricing-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-lg);
		/* Stretch, so the CTAs line up along the foot of the row. */
		align-items: stretch;
	}

	.pricing-card {
		position: relative;
		padding: var(--spacing-xl);
		background: var(--color-surface);
		border: var(--line-hair) solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-lg);
		transition:
			border-color var(--transition-base),
			transform var(--transition-base),
			box-shadow var(--transition-base);
	}

	.pricing-card:hover {
		border-color: color-mix(in srgb, var(--color-brand) 45%, var(--color-border));
		transform: translateY(-3px);
		box-shadow: var(--shadow-lg);
	}

	/* The highlighted plan is the ink plate, like the spotlight and CTA. */
	.pricing-highlighted,
	.pricing-highlighted:hover {
		color: var(--color-plate-muted);
		background: var(--color-plate);
		border: var(--line-ink) solid var(--color-plate-border);
		box-shadow: var(--shadow-xl);
	}

	.pricing-highlighted .pricing-name,
	.pricing-highlighted .pricing-amount {
		color: var(--color-plate-ink);
	}

	.pricing-highlighted .pricing-description,
	.pricing-highlighted .pricing-period {
		color: var(--color-plate-muted);
	}

	.pricing-highlighted .pricing-plan-header {
		border-bottom-color: color-mix(in srgb, var(--color-plate-ink) 22%, transparent);
	}

	.pricing-highlighted .check-icon {
		color: var(--color-accent-soft);
	}

	/* The pick of the issue gets the accent pill. */
	.pricing-badge {
		position: absolute;
		top: 0;
		left: var(--spacing-xl);
		transform: translateY(-50%) rotate(-2deg);
		padding: 3px 14px;
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-on-control);
		background: var(--color-accent-text);
		border-radius: var(--radius-full);
		box-shadow: var(--shadow-sm);
		white-space: nowrap;
	}

	.pricing-plan-header {
		padding-bottom: var(--spacing-lg);
		border-bottom: var(--line-hair) solid var(--color-border);
	}

	.pricing-name {
		font-family: var(--font-heading);
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-heading);
		margin-bottom: var(--spacing-sm);
	}

	.pricing-price {
		display: flex;
		align-items: baseline;
		gap: var(--spacing-xs);
		margin-bottom: var(--spacing-sm);
	}

	.pricing-amount {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
	}

	.pricing-period {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.pricing-description {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.pricing-features {
		list-style: none;
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
	}

	.pricing-features li {
		display: flex;
		align-items: flex-start;
		gap: var(--spacing-sm);
		font-size: var(--font-size-sm);
	}

	.check-icon {
		width: 18px;
		height: 18px;
		flex-shrink: 0;
		color: var(--color-brand-strong);
		margin-top: 2px;
	}

	.pricing-cta {
		width: 100%;
	}

	/* The highlighted plan is the ink plate, so its stamp inverts to paper. */
	.pricing-highlighted .pricing-cta {
		color: var(--color-plate);
		background: var(--color-plate-ink);
		border-color: var(--color-plate-ink);
	}

	.pricing-highlighted .pricing-cta:hover {
		background: var(--color-plate-ink-bright);
		border-color: var(--color-plate-ink-bright);
	}

	@media (max-width: 900px) {
		.pricing-grid {
			grid-template-columns: 1fr;
			max-width: 28rem;
			/* Room for the badge that overhangs the highlighted card. */
			row-gap: var(--spacing-xl);
		}
	}
</style>
