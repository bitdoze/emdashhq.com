---
import { getHubEntries } from "../../lib/hub-content";
import { Icon } from "astro-iconset/components";
import { Image } from "emdash/ui";
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { hostOf, labelize } from "../../lib/format";
import { linkAttrs } from "../../lib/links";
import NewTab from "../NewTab.astro";
import FilterBar from "./FilterBar.astro";
import SectionHeader from "./SectionHeader.astro";
import SectionLink from "./SectionLink.astro";

type TutorialsBlock = Extract<PageContentBlock, { _type: "site_tutorials" }>;
type Props = BlockComponentProps<TutorialsBlock>;

const { value } = Astro.props;
const { anchor_id, headline, subheadline, show_filters } = value;

const tutorials = await getHubEntries(Astro, "tutorials", value);

const topics = [...new Set(tutorials.map((entry) => entry.data.topic).filter(Boolean))].map((topic) => ({
	value: topic as string,
	label: labelize(topic),
}));
---

<section class="section" id={anchor_id || undefined}>
	<div class="container" data-filter-root>
		<SectionHeader headline={headline} subheadline={subheadline} meta="Guides" />
		{show_filters && <FilterBar options={topics} label="Filter tutorials by topic" />}

		{
			tutorials.length > 0 ? (
				<div class="card-grid tutorial-grid">
					{tutorials.map((entry, i) => {
						const link = linkAttrs(entry.data.url);
						const host = hostOf(entry.data.url) || "the site";
						return (
							<article class="hub-card tutorial-card" data-filter-item data-filter-value={entry.data.topic}>
								<div class="tutorial-media">
									{entry.data.image ? (
										<Image image={entry.data.image} class="tutorial-shot" alt="" />
									) : (
										<div class="tutorial-plate" aria-hidden="true">
											<span class="plate-no">{String(i + 1).padStart(2, "0")}</span>
											<span class="plate-tag">{labelize(entry.data.topic || "Guide")}</span>
										</div>
									)}
								</div>
								<div class="tutorial-body">
									<div class="badges">
										{entry.data.topic && <span class="badge">{labelize(entry.data.topic)}</span>}
										{entry.data.level && <span class="badge badge-muted">{labelize(entry.data.level)}</span>}
										{entry.data.featured && <span class="badge badge-featured">Featured</span>}
									</div>
									<h3 class="tutorial-title">
										<a href={link.href} target={link.target} rel={link.rel} class="card-link">
											{entry.data.title}
											{link.target === "_blank" && <><span class="ext-arrow" aria-hidden="true">↗</span><NewTab /></>}
										</a>
									</h3>
									{entry.data.summary && <p class="tutorial-summary">{entry.data.summary}</p>}
									<span class="tutorial-source">
										Read on {host}
										<Icon name="ph:arrow-right" aria-hidden="true" />
									</span>
								</div>
							</article>
						);
					})}
				</div>
			) : (
				<p class="empty-note">No tutorials published yet.</p>
			)
		}

		<SectionLink label={value.section_cta_label} url={value.section_cta_url} />
	</div>
</section>

<style>
	/*
	 * The guides shelf: cover-card grid. Tutorials with no image get an
	 * editorial index plate (big numeral + topic) instead of a blank top.
	 */
	.tutorial-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.tutorial-media {
		position: relative;
		overflow: hidden;
		border-bottom: 1px solid var(--color-border);
	}

	.tutorial-card :global(.tutorial-shot) {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		transition: transform 0.4s cubic-bezier(0.2, 0, 0.2, 1);
	}

	.tutorial-card:hover :global(.tutorial-shot) {
		transform: scale(1.04);
	}

	.tutorial-plate {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--spacing-md);
		aspect-ratio: 16 / 10;
		padding: var(--spacing-lg);
		background:
			linear-gradient(135deg, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 55%),
			color-mix(in srgb, var(--color-brand) 5%, var(--color-surface));
		transition: background var(--transition-base);
	}

	.tutorial-card:hover .tutorial-plate {
		background:
			linear-gradient(135deg, color-mix(in srgb, var(--color-accent) 16%, transparent), transparent 55%),
			color-mix(in srgb, var(--color-brand) 7%, var(--color-surface));
	}

	.plate-no {
		font-family: var(--font-heading);
		font-size: var(--font-size-5xl);
		font-weight: 800;
		font-style: italic;
		line-height: 0.9;
		color: var(--color-accent-text);
		font-variant-numeric: tabular-nums;
	}

	.plate-tag {
		align-self: flex-start;
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.tutorial-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: var(--spacing-sm);
		padding: var(--spacing-xl);
	}

	.tutorial-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		line-height: 1.3;
		text-wrap: pretty;
	}

	/* inline-block keeps the marker out of the underline on mobile. */
	.ext-arrow {
		display: inline-block;
		margin-left: 0.3em;
		font-family: var(--font-body);
		font-size: 0.65em;
		font-style: normal;
		vertical-align: 0.15em;
		color: var(--color-accent-text);
	}

	.tutorial-summary {
		flex: 1;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.tutorial-source {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		align-self: flex-start;
		margin-top: var(--spacing-sm);
		padding-top: var(--spacing-md);
		width: 100%;
		border-top: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-brand-strong);
		transition: color var(--transition-fast);
	}

	.tutorial-source :global(svg) {
		margin-left: auto;
		transition: transform var(--transition-base);
	}

	.tutorial-card:hover .tutorial-source {
		color: var(--color-accent-text);
	}

	.tutorial-card:hover .tutorial-source :global(svg) {
		transform: translate(2px, -2px);
	}
</style>
