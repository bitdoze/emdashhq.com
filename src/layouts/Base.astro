---
import { getSiteChrome } from "../lib/site-data";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import { Icon } from "astro-iconset/components";
import { linkAttrs, isCurrentPath } from "../lib/links";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title?: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, robots, content } = Astro.props;
const [
	settingsResult,
	menuResult,
	headerCtaResult,
	footerLearnResult,
	footerResourcesResult,
	footerCompanyResult,
] = await getSiteChrome(Astro);

const settings = settingsResult.data;
const siteTitle = settings?.title || "EmDash HQ";
const fullTitle = title ? (title.includes(siteTitle) ? title : `${title} | ${siteTitle}`) : siteTitle;
const siteDescription = settings?.tagline || "Tutorials, videos, themes and plugins for EmDash CMS";
const siteLogo = settings.logo?.url ? settings.logo : null;
const menu = menuResult.data;
const headerCta = headerCtaResult.data?.items[0];

const footerColumns = [footerLearnResult.data, footerResourcesResult.data, footerCompanyResult.data].flatMap(
	(column) => (column && column.items.length > 0 ? [column] : []),
);

const socialLinks = [
	{ label: "YouTube", icon: "ph:youtube-logo", url: settings.social?.youtube },
	{ label: "GitHub", icon: "ph:github-logo", url: settings.social?.github },
	{ label: "X", icon: "ph:x-logo", url: settings.social?.twitter },
].flatMap(({ url, ...link }) => (url ? [{ ...link, url }] : []));

const menuLink = (item: { url: string; target?: string | null }) => {
	const link = linkAttrs(item.url);
	return item.target === "_blank"
		? { ...link, target: "_blank" as const, rel: "noopener noreferrer" }
		: link;
};

const headerCtaLink = headerCta ? menuLink(headerCta) : undefined;

const isCurrent = (url: string) => isCurrentPath(url, Astro.url);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title ?? siteTitle,
	description: description || siteDescription,
	canonical: canonical ?? `${Astro.url.origin}${Astro.url.pathname}`,
	image,
	content,
	seo: { ogImage: image, robots },
	siteName: siteTitle,
});

const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" preload />
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var match = document.cookie.match(/(?:^|;\s*)theme=(light|dark)(?:;|$)/);
				var theme = match ? match[1] : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
					document.documentElement.dataset.mode = theme;
				}
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<EmDashBodyStart page={pageCtx} />
		<header class="site-header">
			<nav class="nav" aria-label="Main">
				<a href="/" class="site-logo">
					{siteLogo
						? <img
							src={siteLogo.url}
							alt={siteLogo.alt || siteTitle}
							width={siteLogo.width}
							height={siteLogo.height}
							class="site-logo-img"
						/>
						: siteTitle
					}
				</a>
				<button
					type="button"
					class="nav-toggle"
					aria-expanded="false"
					aria-controls="nav-panel"
					aria-label="Toggle menu"
				>
					<Icon name="ph:list" class="nav-toggle-open" aria-hidden="true" />
					<Icon name="ph:x" class="nav-toggle-close" aria-hidden="true" />
				</button>
				<div class="nav-panel" id="nav-panel">
					<div class="nav-links">
						{
							menu?.items.map((item, i) => {
								const link = menuLink(item);
								return (
									<a
										href={link.href}
										target={link.target}
										rel={link.rel}
										aria-current={isCurrent(item.url) ? "page" : undefined}
									>
										<span class="nav-no" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
										{item.label}
									</a>
								);
							})
						}
					</div>
					<div class="nav-actions">
						{isLoggedIn && <a href="/_emdash/admin" class="nav-admin" data-astro-prefetch="false">Admin</a>}
						{
							headerCta && headerCtaLink && (
								<a
									href={headerCtaLink.href}
									target={headerCtaLink.target}
									rel={headerCtaLink.rel}
									class="btn btn-primary nav-cta"
								>
									{headerCta.label}
								</a>
							)
						}
					</div>
				</div>
			</nav>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-content">
				<div class="footer-brand">
					<span class="footer-logo">
						{siteLogo
								? <img
									src={siteLogo.url}
									alt={siteLogo.alt || siteTitle}
									width={siteLogo.width}
									height={siteLogo.height}
									class="footer-logo-img"
								/>
							: siteTitle
						}
					</span>
					<p class="footer-tagline">{siteDescription}</p>
					{
						socialLinks.length > 0 && (
							<ul class="footer-social">
								{socialLinks.map((social) => (
									<li>
										<a
											href={linkAttrs(social.url).href}
											target="_blank"
											rel="noopener noreferrer"
											aria-label={social.label}
										>
											<Icon name={social.icon} aria-hidden="true" />
										</a>
									</li>
								))}
							</ul>
						)
					}
				</div>
				<div class="footer-links">
					{
						footerColumns.map((column) => (
							<div class="footer-col">
								<h4>{column.label}</h4>
								{column.items.map((item) => {
									const link = menuLink(item);
									return (
										<a href={link.href} target={link.target} rel={link.rel}>
											{item.label}
										</a>
									);
								})}
							</div>
						))
					}
				</div>
			</div>
			<div class="footer-bottom">
				<p>
					&copy; {new Date().getFullYear()} {siteTitle}. All rights reserved.
				</p>
				<p class="footer-status" aria-label="Site status">
					<span class="status-dot" aria-hidden="true"></span>
					Built with EmDash
				</p>
				<div class="theme-switcher">
					<button
						type="button"
						class="theme-btn"
						data-theme="light"
						aria-pressed="false"
						aria-label="Light mode">Light</button
					>
					<button
						type="button"
						class="theme-btn"
						data-theme="dark"
						aria-pressed="false"
						aria-label="Dark mode">Dark</button
					>
					<button
						type="button"
						class="theme-btn"
						data-theme="system"
						aria-pressed="false"
						aria-label="System theme">System</button
					>
				</div>
				<p class="footer-powered">
					Powered by <a href="https://emdashcms.com">EmDash</a>
				</p>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />

		<script>
			// Mobile menu
			const navToggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
			const siteHeader = document.querySelector<HTMLElement>(".site-header");
			if (navToggle && siteHeader) {
				const setOpen = (open: boolean) => {
					navToggle.setAttribute("aria-expanded", String(open));
					siteHeader.classList.toggle("nav-open", open);
				};
				navToggle.addEventListener("click", () => setOpen(navToggle.getAttribute("aria-expanded") !== "true"));
				siteHeader.addEventListener("keydown", (event) => {
					if (event.key === "Escape" && navToggle.getAttribute("aria-expanded") === "true") {
						setOpen(false);
						navToggle.focus();
					}
				});
				siteHeader.classList.add("nav-enhanced");
			}
		</script>

		<script>
			// Theme switcher
			const THEME_REGEX = /(?:^|;\s*)theme=(light|dark)(?:;|$)/;
			const themeBtns =
				document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			const root = document.documentElement;

			function setTheme(theme: string) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (theme === "system") {
					document.cookie = `theme=; path=/; max-age=0; SameSite=Lax${secure}`;
					root.classList.remove("light", "dark");
					delete root.dataset.mode;
				} else {
					document.cookie = `theme=${theme}; path=/; max-age=31536000; SameSite=Lax${secure}`;
					root.classList.remove("light", "dark");
					root.classList.add(theme);
					root.dataset.mode = theme;
				}
				updateActiveBtn(theme);
			}

			function updateActiveBtn(theme: string) {
				themeBtns.forEach((btn) => {
					const active = btn.dataset.theme === theme;
					btn.classList.toggle("active", active);
					btn.setAttribute("aria-pressed", String(active));
				});
			}

			function getStoredTheme(): string {
				const match = document.cookie.match(THEME_REGEX);
				return match ? match[1] : "system";
			}

			// Initialize - apply stored theme on load
			const storedTheme = getStoredTheme();
			setTheme(storedTheme);

			themeBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					setTheme(btn.dataset.theme || "system");
				});
			});
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*,
				*::before,
				*::after {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
				}

				/*
				 * Design tokens live in src/styles/tokens.css. Colors are
				 * defined with light-dark(); these rules pin the scheme when
				 * the footer switcher sets an explicit choice. With no class,
				 * color-scheme: light dark follows the OS preference. The
				 * @supports guard keeps the toggle from forcing dark UA form
				 * controls on browsers stuck on the plain-light fallback.
				 */
				@supports (color: light-dark(#000, #fff)) {
					:root.light,
					:root[data-mode="light"] {
						color-scheme: light;
					}

					:root.dark,
					:root[data-mode="dark"] {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
				}

				@media (prefers-reduced-motion: reduce) {
					html {
						scroll-behavior: auto;
					}

					*,
					*::before,
					*::after {
						scroll-behavior: auto !important;
						transition-duration: 0.01ms !important;
					}
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-normal);
					color: var(--color-text);
					background-color: var(--color-bg);
					/* The sheet's 5mm graph: fine grid with a stronger line every fifth. */
					background-image:
						linear-gradient(light-dark(rgba(30, 64, 175, 0.055), rgba(219, 231, 251, 0.05)) 1px, transparent 1px),
						linear-gradient(90deg, light-dark(rgba(30, 64, 175, 0.055), rgba(219, 231, 251, 0.05)) 1px, transparent 1px),
						linear-gradient(light-dark(rgba(30, 64, 175, 0.03), rgba(219, 231, 251, 0.028)) 1px, transparent 1px),
						linear-gradient(90deg, light-dark(rgba(30, 64, 175, 0.03), rgba(219, 231, 251, 0.028)) 1px, transparent 1px);
					background-size:
						140px 140px,
						140px 140px,
						28px 28px,
						28px 28px;
					-webkit-font-smoothing: antialiased;
					min-height: 100vh;
				}

				/* Scrollbar in ink, so even the chrome ships with the design. */
				* {
					scrollbar-width: thin;
					scrollbar-color: color-mix(in srgb, var(--color-brand-strong) 55%, var(--color-border)) transparent;
				}

				.skip-link {
					position: absolute;
					top: -100%;
					left: var(--spacing-md);
					z-index: 200;
					padding: var(--spacing-sm) var(--spacing-md);
					font-family: var(--font-mono);
					font-size: var(--font-size-sm);
					color: var(--color-on-brand);
					background: var(--color-brand-strong);
					border-radius: var(--radius);
				}

				.skip-link:focus-visible {
					top: var(--spacing-sm);
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: currentColor;
					text-decoration: none;
				}

					/* Bare links in authored content need a visible style; component
					   links restyle themselves via classes. */
				p a:not([class]),
				li a:not([class]) {
					color: var(--color-brand);
					text-decoration: underline;
					text-underline-offset: 2px;
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					font-weight: var(--font-weight-heading);
					line-height: var(--leading-snug);
					letter-spacing: var(--tracking-snug);
					text-wrap: balance;
				}

				h1 {
					font-size: var(--font-size-5xl);
				}
				h2 {
					font-size: var(--font-size-3xl);
				}
				h3 {
					font-size: var(--font-size-2xl);
				}
				h4 {
					font-size: var(--font-size-xl);
				}

				/* Utility classes */
				.container {
					max-width: var(--wide-width);
					margin: 0 auto;
					padding: 0 var(--spacing-lg);
				}

				.section {
					padding: var(--spacing-5xl) 0;
				}

				.section-header {
					text-align: center;
					max-width: var(--max-width);
					margin: 0 auto var(--spacing-4xl);
				}

				.section-headline {
					font-size: var(--font-size-3xl);
					font-weight: var(--font-weight-display);
				}

				.section-subheadline {
					margin-top: var(--spacing-md);
					font-size: var(--font-size-lg);
					color: var(--color-muted);
				}

				.icon-tile {
					width: 44px;
					height: 44px;
					display: flex;
					align-items: center;
					justify-content: center;
					flex-shrink: 0;
					font-size: 1.35rem;
					color: var(--color-brand-strong);
					background: color-mix(in srgb, var(--color-brand) 6%, var(--color-surface));
					border: var(--line-hair) solid color-mix(in srgb, var(--color-brand) 35%, transparent);
					border-radius: var(--radius);
				}

				.btn {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					gap: var(--spacing-sm);
					padding: 0.625rem 1.125rem;
					font-family: var(--font-mono);
					font-size: var(--font-size-xs);
					font-weight: 600;
					letter-spacing: 0.07em;
					text-transform: uppercase;
					line-height: 1.2;
					border-radius: var(--radius);
					border: var(--line-ink) solid var(--color-brand-strong);
					cursor: pointer;
					transition:
						background var(--transition-fast),
						border-color var(--transition-fast),
						color var(--transition-fast),
						transform var(--transition-fast);
				}

				.btn:active {
					transform: translateY(1px);
				}

				.btn-primary {
					color: var(--color-on-brand);
					background: var(--color-brand-strong);
					border-color: var(--color-brand-strong);
				}

				.btn-primary:hover {
					background: var(--color-brand);
					border-color: var(--color-brand);
				}

				.btn-secondary {
					color: var(--color-brand-strong);
					background: transparent;
					border-color: color-mix(in srgb, var(--color-brand-strong) 55%, var(--color-border));
				}

				.btn-secondary:hover {
					border-color: var(--color-brand-strong);
					background: color-mix(in srgb, var(--color-brand) 7%, transparent);
				}

				.btn-lg {
					padding: 0.875rem 1.5rem;
					font-size: var(--font-size-sm);
				}
			}
		</style>

		<style>
			.site-header {
				position: sticky;
				top: 0;
				z-index: 100;
				background: color-mix(in srgb, var(--color-bg) 92%, transparent);
				border-bottom: var(--line-ink) solid var(--color-text);
			}

			.nav {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-md) var(--spacing-lg);
				display: flex;
				flex-wrap: nowrap;
				align-items: center;
				gap: var(--spacing-lg);
			}

			.site-logo {
				font-family: var(--font-heading);
				font-size: var(--font-size-2xl);
				font-weight: var(--font-weight-display);
				letter-spacing: 0.02em;
				text-transform: uppercase;
				color: var(--color-text);
			}

			.site-logo:hover {
				color: var(--color-brand-strong);
			}

			.site-logo-img {
				height: 64px;
				width: auto;
				display: block;
				margin: -8px 0;
			}

			.nav-toggle {
				display: none;
				margin-left: auto;
				padding: var(--spacing-sm);
				font-size: 1.5rem;
				line-height: 0;
				color: var(--color-text);
				background: transparent;
				border: 1px solid var(--color-border);
				border-radius: var(--radius-sm);
				cursor: pointer;
			}

			.nav-toggle :global(.nav-toggle-close),
			.nav-toggle[aria-expanded="true"] :global(.nav-toggle-open) {
				display: none;
			}

			.nav-toggle[aria-expanded="true"] :global(.nav-toggle-close) {
				display: block;
			}

			.nav-panel {
				display: flex;
				flex: 1;
				align-items: center;
				gap: var(--spacing-lg);
			}

			.nav-links {
				display: flex;
				flex-wrap: wrap;
				gap: var(--spacing-lg);
				margin-left: auto;
			}

			.nav-links a {
				position: relative;
				display: inline-flex;
				align-items: baseline;
				gap: 6px;
				font-family: var(--font-mono);
				font-size: var(--font-size-xs);
				font-weight: 500;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				color: var(--color-muted);
				transition: color var(--transition-fast);
				padding-bottom: 2px;
			}

			.nav-no {
				font-size: calc(var(--font-size-xs) * 0.9);
				color: color-mix(in srgb, var(--color-muted) 65%, transparent);
			}

			.nav-links a::after {
				content: "";
				position: absolute;
				left: 0;
				right: 100%;
				bottom: -4px;
				height: 2px;
				background: var(--color-brand-strong);
				transition: right var(--transition-base);
			}

			.nav-links a:hover::after,
			.nav-links a[aria-current="page"]::after {
				right: 0;
			}

			.nav-links a:hover,
			.nav-links a[aria-current="page"] {
				color: var(--color-text);
			}

			.nav-links a[aria-current="page"] {
				color: var(--color-brand-strong);
				font-weight: 600;
				text-decoration: none;
			}

			.nav-links a[aria-current="page"] .nav-no {
				color: var(--color-brand-strong);
			}

			.nav-actions {
				display: flex;
				align-items: center;
				gap: var(--spacing-lg);
			}

			.nav-admin {
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				opacity: 0.5;
			}

			/* Compact variant of .btn.btn-primary for the header */
			.nav-cta {
				padding: 0.5rem 1rem;
				white-space: nowrap;
			}

			main {
				min-height: calc(100vh - 200px);
			}

			.site-footer {
				/* The set's cover sheet: blueprint ground in both modes. */
				background:
					linear-gradient(rgba(219, 231, 251, 0.035) 1px, transparent 1px),
					linear-gradient(90deg, rgba(219, 231, 251, 0.035) 1px, transparent 1px),
					light-dark(#0d2340, #081a33);
				background-size: 28px 28px, 28px 28px, auto;
				border-top: 3px solid var(--color-brand-strong);
				color: #cdddf5;
			}

			.footer-content {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-4xl) var(--spacing-lg) var(--spacing-2xl);
				display: grid;
				grid-template-columns: 1fr 2fr;
				gap: var(--spacing-4xl);
			}

			.footer-logo {
				font-family: var(--font-heading);
				font-size: var(--font-size-lg);
				font-weight: var(--font-weight-display);
				letter-spacing: 0.02em;
				text-transform: uppercase;
				color: #fff;
			}

			.footer-logo-img {
				height: 24px;
				width: auto;
			}

			.footer-tagline {
				margin-top: var(--spacing-sm);
				font-size: var(--font-size-sm);
				color: #8fa8cd;
			}

			.footer-social {
				display: flex;
				gap: var(--spacing-sm);
				margin-top: var(--spacing-lg);
				list-style: none;
			}

			.footer-social a {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 40px;
				height: 40px;
				font-size: 1.25rem;
				color: #8fa8cd;
				border: 1px solid rgb(219 231 251 / 0.25);
				border-radius: var(--radius);
				transition:
